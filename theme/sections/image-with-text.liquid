<section class="section section--{{ section.settings.background }}">
  <div class="page-width split{% if section.settings.layout == 'right' %} split--reverse{% endif %}">
    <div class="split__media reveal">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', sizes: '(min-width: 900px) 50vw, 100vw', widths: '600, 900, 1200' }}
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
    </div>
    <div class="split__content reveal">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow | escape }}</span>{%- endif -%}
      <h2>{{ section.settings.heading | escape }}</h2>
      <div class="rte">{{ section.settings.text }}</div>
      {%- if section.settings.button_label != blank -%}
        <p style="margin-top: 2rem;"><a href="{{ section.settings.button_link }}" class="button{% if section.settings.background == 'dark' %} button--light{% endif %}">{{ section.settings.button_label | escape }}</a></p>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Image avec texte",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "select", "id": "layout", "label": "Position de l'image", "default": "left", "options": [
      { "value": "left", "label": "À gauche" }, { "value": "right", "label": "À droite" }
    ] },
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "Notre philosophie" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Un cocon pour votre pratique" },
    { "type": "richtext", "id": "text", "label": "Texte", "default": "<p>Nous sélectionnons des matières naturelles et durables, dans des teintes terre qui apaisent. Parce que l'on pratique mieux quand on se sent bien.</p>" },
    { "type": "text", "id": "button_label", "label": "Bouton" },
    { "type": "url", "id": "button_link", "label": "Lien du bouton" },
    { "type": "select", "id": "background", "label": "Fond", "default": "plain", "options": [
      { "value": "plain", "label": "Crème" }, { "value": "alt", "label": "Lin" }, { "value": "sand", "label": "Sable" }, { "value": "dark", "label": "Expresso" }
    ] }
  ],
  "presets": [{ "name": "Image avec texte" }]
}
{% endschema %}
