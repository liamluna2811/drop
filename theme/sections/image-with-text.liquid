<section
  class="section{% if section.settings.surface %} section--surface{% endif %}"
  style="--section-pt: {{ section.settings.padding_top }}px; --section-pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="page-width image-text{% if section.settings.layout == 'image_right' %} image-text--reverse{% endif %}">
    <div class="image-text__media">
      <div class="media media--{{ section.settings.ratio }}">
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 1600
            | image_tag:
              loading: 'lazy',
              sizes: '(min-width: 750px) 50vw, 100vw',
              widths: '600, 900, 1200, 1600',
              alt: section.settings.image.alt
              | escape
          }}
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>
    </div>
    <div class="image-text__content">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow | escape }}</span>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading | escape }}</h2>{%- endif -%}
      {%- if section.settings.text != blank -%}<div class="rte">{{ section.settings.text }}</div>{%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link }}" class="button button--secondary">{{ section.settings.button_label | escape }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Image avec texte",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    {
      "type": "select",
      "id": "layout",
      "label": "Position de l'image",
      "options": [
        { "value": "image_left", "label": "À gauche" },
        { "value": "image_right", "label": "À droite" }
      ],
      "default": "image_left"
    },
    {
      "type": "select",
      "id": "ratio",
      "label": "Format de l'image",
      "options": [
        { "value": "portrait", "label": "Portrait" },
        { "value": "square", "label": "Carré" },
        { "value": "landscape", "label": "Paysage" }
      ],
      "default": "portrait"
    },
    { "type": "text", "id": "eyebrow", "label": "Surtitre", "default": "Notre savoir-faire" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Fabriqués pour durer" },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texte",
      "default": "<p>Structure en bois massif, suspensions ensachées et tissus déhoussables : chaque canapé est assemblé avec soin dans nos ateliers partenaires en Europe. Des matériaux choisis pour leur robustesse, un design pensé pour traverser les années.</p>"
    },
    { "type": "text", "id": "button_label", "label": "Bouton — texte", "default": "En savoir plus" },
    { "type": "url", "id": "button_link", "label": "Bouton — lien" },
    { "type": "checkbox", "id": "surface", "label": "Fond coloré", "default": false },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 8, "unit": "px", "label": "Marge haute", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 8, "unit": "px", "label": "Marge basse", "default": 80 }
  ],
  "presets": [{ "name": "Image avec texte" }]
}
{% endschema %}
