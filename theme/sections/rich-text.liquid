<section
  class="section{% if section.settings.surface %} section--surface{% endif %}"
  style="--section-pt: {{ section.settings.padding_top }}px; --section-pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="page-width page-narrow text-{{ section.settings.alignment }}">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'heading' -%}
          <h2 {{ block.shopify_attributes }}>{{ block.settings.heading | escape }}</h2>
        {%- when 'text' -%}
          <div class="rte text-muted" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
        {%- when 'button' -%}
          <p style="margin-top:1.75rem" {{ block.shopify_attributes }}>
            <a href="{{ block.settings.link }}" class="button button--secondary">{{ block.settings.label | escape }}</a>
          </p>
      {%- endcase -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Texte",
  "settings": [
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignement",
      "options": [
        { "value": "left", "label": "À gauche" },
        { "value": "center", "label": "Centré" }
      ],
      "default": "center"
    },
    { "type": "checkbox", "id": "surface", "label": "Fond coloré", "default": false },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 8, "unit": "px", "label": "Marge haute", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 8, "unit": "px", "label": "Marge basse", "default": 80 }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "Titre",
      "limit": 1,
      "settings": [{ "type": "text", "id": "heading", "label": "Titre", "default": "Un canapé, c'est pour longtemps" }]
    },
    {
      "type": "text",
      "name": "Texte",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Texte",
          "default": "<p>Présentez votre marque en quelques phrases : votre histoire, vos valeurs, ce qui rend vos canapés uniques.</p>"
        }
      ]
    },
    {
      "type": "button",
      "name": "Bouton",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "label", "label": "Texte", "default": "Notre histoire" },
        { "type": "url", "id": "link", "label": "Lien" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Texte",
      "blocks": [{ "type": "heading" }, { "type": "text" }]
    }
  ]
}
{% endschema %}
