<section
  class="section{% if section.settings.surface %} section--surface{% endif %}"
  style="--section-pt: {{ section.settings.padding_top }}px; --section-pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="page-width">
    <div class="newsletter">
      <h2>{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}
        <div class="rte text-muted">{{ section.settings.text }}</div>
      {%- endif -%}

      {%- form 'customer', id: 'NewsletterForm', class: 'newsletter__form-wrapper' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        {%- if form.posted_successfully? -%}
          <p class="form-message" role="status">{{ 'newsletter.success' | t }}</p>
        {%- else -%}
          {%- if form.errors -%}
            <p class="form-message form-message--error" role="alert">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
          {%- endif -%}
          <div class="newsletter__form">
            <label for="NewsletterEmail" class="visually-hidden">{{ 'newsletter.label' | t }}</label>
            <input
              id="NewsletterEmail"
              class="input"
              type="email"
              name="contact[email]"
              autocomplete="email"
              placeholder="{{ 'newsletter.placeholder' | t }}"
              required
            >
            <button type="submit" class="button">{{ 'newsletter.button' | t }}</button>
          </div>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre", "default": "Restons en contact" },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texte",
      "default": "<p>Nouveautés, conseils déco et offres réservées aux abonnés. Pas plus d'un e-mail par mois.</p>"
    },
    { "type": "checkbox", "id": "surface", "label": "Fond coloré", "default": false },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 8, "unit": "px", "label": "Marge haute", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 8, "unit": "px", "label": "Marge basse", "default": 80 }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
