<div class="page-width">
  <header class="page-header">
    <h1 style="margin:0">{{ 'cart.title' | t }}</h1>
  </header>

  {%- if cart.item_count > 0 -%}
    <div class="cart-layout">
      <div>
        <form action="{{ routes.cart_url }}" method="post" id="CartForm" class="cart-items" novalidate data-cart-page>
          {%- for item in cart.items -%}
            {% render 'cart-line', item: item, line: forloop.index, context: 'page' %}
          {%- endfor -%}
          <noscript>
            <p style="margin-top:1rem"><button type="submit" name="update" class="button button--secondary">{{ 'cart.update' | t }}</button></p>
          </noscript>
        </form>

        {%- if section.settings.show_note -%}
          <div class="cart-note field">
            <label for="CartNote">{{ 'cart.note' | t }}</label>
            <textarea id="CartNote" class="textarea" name="note" form="CartForm" placeholder="{{ 'cart.note_placeholder' | t }}">{{ cart.note }}</textarea>
          </div>
        {%- endif -%}
      </div>

      <aside class="cart-summary" aria-label="{{ 'cart.summary' | t }}">
        {% render 'free-shipping' %}
        <div class="cart-summary__row">
          <span>{{ 'cart.subtotal' | t }}</span>
          <span>{{ cart.items_subtotal_price | money }}</span>
        </div>
        {%- for discount in cart.cart_level_discount_applications -%}
          <div class="cart-summary__row">
            <span>{{ discount.title }}</span>
            <span>-{{ discount.total_allocated_amount | money }}</span>
          </div>
        {%- endfor -%}
        <div class="cart-summary__row">
          <span>{{ 'cart.shipping' | t }}</span>
          <span class="text-muted">{{ 'cart.shipping_calculated' | t }}</span>
        </div>
        <div class="cart-summary__row cart-summary__row--total">
          <span>{{ 'cart.total' | t }}</span>
          <span>{{ cart.total_price | money_with_currency }}</span>
        </div>
        <p class="cart-summary__note">{{ 'cart.taxes_and_shipping' | t }}</p>
        <button type="submit" name="checkout" form="CartForm" class="button button--full">
          {%- render 'icon', name: 'lock' -%}
          {{ 'cart.checkout' | t }}
        </button>
        {%- if additional_checkout_buttons and section.settings.show_express -%}
          <div style="margin-top:0.75rem">{{ content_for_additional_checkout_buttons }}</div>
        {%- endif -%}
        <div class="cart-trust">
          <p>{%- render 'icon', name: 'lock' -%}{{ 'cart.trust_secure' | t }}</p>
          <p>{%- render 'icon', name: 'truck' -%}{{ 'cart.trust_delivery' | t }}</p>
          <p>{%- render 'icon', name: 'return' -%}{{ 'cart.trust_returns' | t }}</p>
        </div>
      </aside>
    </div>
  {%- else -%}
    <div class="empty-state">
      <p class="h3">{{ 'cart.empty' | t }}</p>
      <p class="text-muted">{{ 'cart.empty_text' | t }}</p>
      <a href="{{ routes.all_products_collection_url }}" class="button">{{ 'cart.continue_shopping' | t }}</a>
    </div>
  {%- endif -%}
</div>

<div style="height: 5rem"></div>

{% schema %}
{
  "name": "Panier",
  "settings": [
    { "type": "checkbox", "id": "show_note", "label": "Permettre un message (instructions de livraison…)", "default": true },
    { "type": "checkbox", "id": "show_express", "label": "Afficher les paiements express", "default": true }
  ]
}
{% endschema %}
