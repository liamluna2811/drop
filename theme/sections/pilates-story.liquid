<section class="section section--{{ section.settings.background }}" id="histoire">
  <div class="page-width story__grid">
    <div class="story__intro reveal">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow | escape }}</span>{%- endif -%}
      <h2>{{ section.settings.heading | escape }}</h2>
      {{ section.settings.text }}
      {%- if section.settings.quote != blank -%}
        <blockquote class="story__quote">
          « {{ section.settings.quote | escape }} »
          {%- if section.settings.quote_author != blank -%}<cite>{{ section.settings.quote_author | escape }}</cite>{%- endif -%}
        </blockquote>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link }}" class="link-arrow">{{ section.settings.button_label | escape }}</a>
      {%- endif -%}
    </div>
    <ol class="timeline">
      {%- for block in section.blocks -%}
        <li class="timeline__item reveal" {{ block.shopify_attributes }}>
          <div class="timeline__year">{{ block.settings.year | escape }}</div>
          <h3>{{ block.settings.title | escape }}</h3>
          <p>{{ block.settings.text | escape }}</p>
        </li>
      {%- endfor -%}
    </ol>
  </div>
</section>

{% schema %}
{
  "name": "Histoire du Pilates",
  "max_blocks": 10,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "Un peu d'histoire" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Joseph Pilates et la « Contrology »" },
    { "type": "richtext", "id": "text", "label": "Texte", "default": "<p>Bien avant de remplir les studios du monde entier, le Pilates est né de l'obstination d'un homme : Joseph Hubertus Pilates, persuadé que la santé du corps et celle de l'esprit ne font qu'un.</p>" },
    { "type": "text", "id": "quote", "label": "Citation", "default": "En 10 séances, vous sentirez la différence ; en 20, vous la verrez ; en 30, vous aurez un nouveau corps." },
    { "type": "text", "id": "quote_author", "label": "Auteur de la citation", "default": "Attribuée à Joseph Pilates" },
    { "type": "text", "id": "button_label", "label": "Lien", "default": "Lire toute l'histoire" },
    { "type": "url", "id": "button_link", "label": "URL du lien", "default": "/pages/histoire-et-bienfaits" },
    { "type": "select", "id": "background", "label": "Fond", "default": "plain", "options": [
      { "value": "plain", "label": "Crème" }, { "value": "alt", "label": "Lin" }, { "value": "sand", "label": "Sable" }
    ] }
  ],
  "blocks": [
    {
      "type": "event",
      "name": "Étape",
      "settings": [
        { "type": "text", "id": "year", "label": "Année", "default": "1883" },
        { "type": "text", "id": "title", "label": "Titre", "default": "Titre" },
        { "type": "textarea", "id": "text", "label": "Texte" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Histoire du Pilates",
      "blocks": [
        { "type": "event", "settings": { "year": "1883", "title": "Une enfance fragile", "text": "Joseph Pilates naît près de Düsseldorf, en Allemagne. Enfant asthmatique et de santé fragile, il se passionne pour la gymnastique, la boxe et l'anatomie pour renforcer son corps." } },
        { "type": "event", "settings": { "year": "1914", "title": "Naissance d'une méthode", "text": "Installé en Angleterre, il est interné pendant la Première Guerre mondiale. Il fait travailler ses codétenus et fixe des ressorts aux lits de l'infirmerie : l'ancêtre du Reformer est né." } },
        { "type": "event", "settings": { "year": "1926", "title": "Le studio de New York", "text": "Avec sa femme Clara, il ouvre un studio sur la 8e Avenue. Les danseurs et chorégraphes de Broadway adoptent vite sa méthode pour se renforcer et se rééduquer." } },
        { "type": "event", "settings": { "year": "1945", "title": "Return to Life", "text": "Il publie « Return to Life Through Contrology » et y décrit 34 exercices au sol, toujours à la base des cours de Pilates Mat actuels." } },
        { "type": "event", "settings": { "year": "Aujourd'hui", "title": "Une pratique universelle", "text": "Transmise par Clara puis par ses élèves, la méthode est aujourd'hui pratiquée par des millions de personnes, au sol comme sur machine, du sportif de haut niveau à la rééducation." } }
      ]
    }
  ]
}
{% endschema %}
