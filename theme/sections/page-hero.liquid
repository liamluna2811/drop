<section class="section section--{{ section.settings.background }}" style="padding-bottom: clamp(2rem, 5vw, 3rem);">
  <div class="page-width">
    <div class="section-header reveal" style="max-width: 48rem; margin-bottom: 0;">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow | escape }}</span>{%- endif -%}
      {%- assign heading_text = section.settings.heading | default: page.title -%}
      <h1>{% render 'rich-heading', text: heading_text %}</h1>
      {%- if section.settings.text != blank -%}{{ section.settings.text }}{%- elsif page.content != blank -%}<div class="rte">{{ page.content }}</div>{%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "En-tête de page",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre" },
    { "type": "text", "id": "heading", "label": "Titre", "info": "Vide = titre de la page. Mettez un mot entre *astérisques* pour l’écrire en italique vert matcha" },
    { "type": "richtext", "id": "text", "label": "Texte", "info": "Vide = contenu de la page" },
    { "type": "select", "id": "background", "label": "Fond", "default": "alt", "options": [
      { "value": "plain", "label": "Lait" }, { "value": "alt", "label": "Latte" }, { "value": "sand", "label": "Avoine" }, { "value": "matcha", "label": "Matcha doux" }
    ] }
  ],
  "presets": [{ "name": "En-tête de page" }]
}
{% endschema %}
