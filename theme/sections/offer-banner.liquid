{%- comment -%}
  Bandeau d'offre avec compte à rebours. Disparaît automatiquement
  une fois la date de fin passée.
{%- endcomment -%}
{%- liquid
  assign end_epoch = 0
  if section.settings.end_date != blank
    assign end_epoch = section.settings.end_date | date: '%s' | plus: 0
  endif
  assign now_epoch = 'now' | date: '%s' | plus: 0
  assign expired = false
  if end_epoch > 0 and end_epoch < now_epoch
    assign expired = true
  endif
-%}

{%- unless expired or section.settings.text == blank -%}
  <div
    class="offer-banner"
    style="--offer-bg: {{ section.settings.background }}; --offer-text: {{ section.settings.text_color }};"
    data-offer-banner
    {% if end_epoch > 0 %}data-end="{{ end_epoch }}"{% endif %}
  >
    <div class="page-width offer-banner__inner">
      {%- if section.settings.link != blank -%}<a href="{{ section.settings.link }}" class="offer-banner__link">{%- endif -%}
      <span class="offer-banner__text">{{ section.settings.text | escape }}</span>
      {%- if end_epoch > 0 -%}
        <span class="offer-banner__timer" role="timer" aria-live="off">
          <span class="offer-banner__ends">{{ 'sections.offer.ends_in' | t }}</span>
          <span><strong data-days>–</strong> {{ 'sections.offer.days' | t }}</span>
          <span><strong data-hours>–</strong> {{ 'sections.offer.hours' | t }}</span>
          <span><strong data-minutes>–</strong> {{ 'sections.offer.minutes' | t }}</span>
          <span><strong data-seconds>–</strong> {{ 'sections.offer.seconds' | t }}</span>
        </span>
      {%- endif -%}
      {%- if section.settings.link != blank -%}</a>{%- endif -%}
    </div>
  </div>
{%- endunless -%}

{% schema %}
{
  "name": "Bandeau d'offre",
  "settings": [
    { "type": "text", "id": "text", "label": "Texte", "default": "Offre de lancement sur une sélection de canapés" },
    {
      "type": "text",
      "id": "end_date",
      "label": "Date de fin",
      "info": "Format : AAAA-MM-JJ HH:MM (ex. 2026-11-30 23:59). Laissez vide pour ne pas afficher de compte à rebours."
    },
    { "type": "url", "id": "link", "label": "Lien" },
    { "type": "color", "id": "background", "label": "Couleur de fond", "default": "#1A1816" },
    { "type": "color", "id": "text_color", "label": "Couleur du texte", "default": "#FFFFFF" }
  ],
  "presets": [{ "name": "Bandeau d'offre" }]
}
{% endschema %}
