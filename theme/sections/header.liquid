{%- liquid
  assign menu = section.settings.menu
-%}
<header class="site-header">
  <div class="page-width site-header__inner">
    <div class="site-header__left">
      <details class="menu-drawer">
        <summary class="icon-button" aria-label="{{ 'sections.header.menu' | t }}">
          {% render 'icon', name: 'menu' %}
        </summary>
        <nav class="menu-drawer__panel" aria-label="{{ 'sections.header.menu' | t }}">
          <ul>
            {%- for link in menu.links -%}
              <li>
                <a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a>
                {%- if link.links != blank -%}
                  <ul>
                    {%- for child in link.links -%}
                      <li><a href="{{ child.url }}">{{ child.title | escape }}</a></li>
                    {%- endfor -%}
                  </ul>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
        </nav>
      </details>

      <nav class="site-header__nav" aria-label="{{ 'sections.header.menu' | t }}">
        <ul>
          {%- for link in menu.links -%}
            <li>
              <a href="{{ link.url }}"{% if link.current or link.child_active %} aria-current="page"{% endif %}>{{ link.title | escape }}</a>
              {%- if link.links != blank -%}
                <div class="site-header__dropdown">
                  <ul>
                    {%- for child in link.links -%}
                      <li><a href="{{ child.url }}">{{ child.title | escape }}</a></li>
                    {%- endfor -%}
                  </ul>
                </div>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      </nav>
    </div>

    <a href="{{ routes.root_url }}" class="site-header__logo">
      {%- if section.settings.logo != blank -%}
        {%- assign logo_height = section.settings.logo_width | divided_by: section.settings.logo.aspect_ratio | round -%}
        {{ section.settings.logo | image_url: width: 400 | image_tag:
          width: section.settings.logo_width,
          height: logo_height,
          alt: shop.name,
          loading: 'eager'
        }}
      {%- else -%}
        <span class="site-header__logo-text">{{ shop.name }}</span>
      {%- endif -%}
    </a>

    <div class="site-header__icons">
      <a href="{{ routes.search_url }}" class="icon-button" aria-label="{{ 'general.search' | t }}">
        {% render 'icon', name: 'search' %}
      </a>
      {%- if shop.customer_accounts_enabled -%}
        <a href="{{ routes.account_url }}" class="icon-button" aria-label="{{ 'general.account' | t }}">
          {% render 'icon', name: 'account' %}
        </a>
      {%- endif -%}
      <a href="{{ routes.cart_url }}" class="icon-button" aria-label="{{ 'general.cart' | t }} ({{ cart.item_count }})">
        {% render 'icon', name: 'cart' %}
        {%- if cart.item_count > 0 -%}
          <span class="cart-count">{{ cart.item_count }}</span>
        {%- endif -%}
      </a>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "En-tête",
  "class": "section-header-wrapper",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    { "type": "range", "id": "logo_width", "label": "Largeur du logo", "min": 60, "max": 300, "step": 10, "unit": "px", "default": 140 },
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" }
  ]
}
{% endschema %}
