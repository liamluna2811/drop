{%- liquid
  assign menu = section.settings.menu
  assign layout = section.settings.layout
-%}

{%- capture logo_markup -%}
  {%- if request.page_type == 'index' -%}<h1 class="header__logo">{%- else -%}<div class="header__logo">{%- endif -%}
    <a href="{{ routes.root_url }}">
      {%- if section.settings.logo != blank -%}
        {%- assign logo_height = section.settings.logo_width | divided_by: section.settings.logo.aspect_ratio | round -%}
        {{
          section.settings.logo
          | image_url: width: 600
          | image_tag:
            width: section.settings.logo_width,
            height: logo_height,
            alt: shop.name,
            style: 'width:auto;'
        }}
      {%- else -%}
        {{ shop.name }}
      {%- endif -%}
    </a>
  {%- if request.page_type == 'index' -%}</h1>{%- else -%}</div>{%- endif -%}
{%- endcapture -%}

{%- capture menu_markup -%}
  {%- if menu != blank -%}
    <ul class="menu" role="list">
      {%- for link in menu.links -%}
        <li class="menu__item">
          {%- if link.links != blank -%}
            <details data-menu-dropdown>
              <summary class="menu__link"{% if link.child_active %} aria-current="page"{% endif %}>
                {{ link.title | escape }}
                {%- render 'icon', name: 'chevron-down' -%}
              </summary>
              <ul class="menu__dropdown" role="list">
                {%- for child in link.links -%}
                  <li>
                    <a href="{{ child.url }}"{% if child.current %} aria-current="page"{% endif %}>
                      {{- child.title | escape -}}
                    </a>
                  </li>
                {%- endfor -%}
                <li><a href="{{ link.url }}">{{ 'header.view_all' | t }}</a></li>
              </ul>
            </details>
          {%- else -%}
            <a href="{{ link.url }}" class="menu__link"{% if link.current %} aria-current="page"{% endif %}>
              {{- link.title | escape -}}
            </a>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  {%- endif -%}
{%- endcapture -%}

{%- capture search_form -%}
  <form action="{{ routes.search_url }}" method="get" role="search" class="header__search">
    <label for="HeaderSearchBar" class="visually-hidden">{{ 'header.search' | t }}</label>
    {%- render 'icon', name: 'search' -%}
    <input
      id="HeaderSearchBar"
      type="search"
      name="q"
      placeholder="{{ 'header.search_placeholder' | t }}"
      autocomplete="off"
    >
    <input type="hidden" name="options[prefix]" value="last">
  </form>
{%- endcapture -%}

{%- capture icons_markup -%}
  <div class="header__icons">
    {%- if layout != 'search' and section.settings.show_search -%}
      <button
        type="button"
        class="icon-button"
        data-search-toggle
        aria-controls="HeaderSearch"
        aria-expanded="false"
        aria-label="{{ 'header.search' | t }}"
      >
        {%- render 'icon', name: 'search' -%}
      </button>
    {%- endif -%}

    {%- if section.settings.help_link != blank -%}
      <a href="{{ section.settings.help_link }}" class="icon-button header__icon--help" aria-label="{{ 'header.help' | t }}">
        {%- render 'icon', name: 'help' -%}
      </a>
    {%- endif -%}

    {%- if shop.customer_accounts_enabled -%}
      <a href="{{ routes.account_url }}" class="icon-button header__icon--account" aria-label="{{ 'header.account' | t }}">
        {%- render 'icon', name: 'account' -%}
      </a>
    {%- endif -%}

    <a href="{{ routes.cart_url }}" class="icon-button" data-cart-toggle aria-label="{{ 'header.cart' | t }}">
      {%- render 'icon', name: 'cart' -%}
      <span class="cart-count" data-cart-count aria-hidden="true">
        {%- if cart.item_count > 0 -%}{{ cart.item_count }}{%- endif -%}
      </span>
      <span class="visually-hidden" data-cart-count-label>{{ 'header.cart_count' | t: count: cart.item_count }}</span>
    </a>
  </div>
{%- endcapture -%}

<div class="header-wrapper{% if section.settings.sticky %} header-wrapper--sticky{% endif %}" data-header>
  {%- if layout == 'search' -%}
    <header class="page-width header header--search">
      <button
        type="button"
        class="icon-button header__menu-toggle"
        data-drawer-open="MenuDrawer"
        aria-controls="MenuDrawer"
        aria-expanded="false"
        aria-label="{{ 'header.menu' | t }}"
      >
        {%- render 'icon', name: 'menu' -%}
      </button>
      {{ logo_markup }}
      {{ search_form }}
      {{ icons_markup }}
    </header>
    {%- if menu != blank -%}
      <nav class="header__nav-row" aria-label="{{ 'header.main_navigation' | t }}">
        <div class="page-width">{{ menu_markup }}</div>
      </nav>
    {%- endif -%}
  {%- else -%}
    <header class="page-width header header--logo-{{ section.settings.logo_position }}">
      <button
        type="button"
        class="icon-button header__menu-toggle"
        data-drawer-open="MenuDrawer"
        aria-controls="MenuDrawer"
        aria-expanded="false"
        aria-label="{{ 'header.menu' | t }}"
      >
        {%- render 'icon', name: 'menu' -%}
      </button>
      {{ logo_markup }}
      {%- if menu != blank -%}
        <nav class="header__nav" aria-label="{{ 'header.main_navigation' | t }}">{{ menu_markup }}</nav>
      {%- endif -%}
      {{ icons_markup }}
    </header>

    {%- if section.settings.show_search -%}
      <div class="search-modal" id="HeaderSearch" hidden>
        <div class="page-width">
          <form action="{{ routes.search_url }}" method="get" role="search" class="search-form">
            <label for="HeaderSearchInput" class="visually-hidden">{{ 'header.search' | t }}</label>
            <input
              id="HeaderSearchInput"
              class="input"
              type="search"
              name="q"
              placeholder="{{ 'header.search_placeholder' | t }}"
              autocomplete="off"
            >
            <input type="hidden" name="options[prefix]" value="last">
            <button type="submit" class="button">{{ 'header.search_submit' | t }}</button>
          </form>
        </div>
      </div>
    {%- endif -%}
  {%- endif -%}
</div>

{%- comment -%} Menu mobile {%- endcomment -%}
<div id="MenuDrawer" class="drawer drawer--left" data-drawer>
  <div class="drawer__overlay" data-drawer-close></div>
  <div class="drawer__panel" role="dialog" aria-modal="true" aria-label="{{ 'header.menu' | t }}" tabindex="-1">
    <div class="drawer__header">
      <span class="h3" style="margin:0">{{ shop.name }}</span>
      <button type="button" class="icon-button" data-drawer-close aria-label="{{ 'accessibility.close' | t }}">
        {%- render 'icon', name: 'close' -%}
      </button>
    </div>
    <div class="drawer__body">
      <nav class="mobile-menu" aria-label="{{ 'header.main_navigation' | t }}">
        {%- for link in menu.links -%}
          {%- if link.links != blank -%}
            <details>
              <summary>{{ link.title | escape }}{%- render 'icon', name: 'chevron-down' -%}</summary>
              <div class="mobile-menu__sub">
                {%- for child in link.links -%}
                  <a href="{{ child.url }}">{{ child.title | escape }}</a>
                {%- endfor -%}
                <a href="{{ link.url }}">{{ 'header.view_all' | t }}</a>
              </div>
            </details>
          {%- else -%}
            <a href="{{ link.url }}">{{ link.title | escape }}</a>
          {%- endif -%}
        {%- endfor -%}
      </nav>
      <div class="mobile-menu mobile-menu__secondary">
        {%- if shop.customer_accounts_enabled -%}
          <a href="{{ routes.account_url }}">{%- render 'icon', name: 'account' -%}{{ 'header.account' | t }}</a>
        {%- endif -%}
        {%- if section.settings.phone != blank -%}
          <a href="tel:{{ section.settings.phone | remove: ' ' }}">{%- render 'icon', name: 'phone' -%}{{ section.settings.phone }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "En-tête",
  "class": "header-section",
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "Disposition",
      "options": [
        { "value": "search", "label": "Barre de recherche visible + menu en dessous" },
        { "value": "classic", "label": "Classique (menu sur une ligne)" }
      ],
      "default": "search"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo",
      "info": "Sans logo, le nom de la boutique s'affiche."
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 60,
      "max": 300,
      "step": 10,
      "unit": "px",
      "label": "Largeur du logo",
      "default": 140
    },
    {
      "type": "select",
      "id": "logo_position",
      "label": "Position du logo (disposition classique)",
      "options": [
        { "value": "left", "label": "À gauche" },
        { "value": "center", "label": "Au centre" }
      ],
      "default": "left"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    },
    {
      "type": "checkbox",
      "id": "sticky",
      "label": "En-tête fixe au défilement",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Afficher la recherche (disposition classique)",
      "default": true
    },
    {
      "type": "url",
      "id": "help_link",
      "label": "Lien « Besoin d'aide ? »",
      "info": "Ex. votre page FAQ ou Contact. Laissez vide pour masquer l'icône."
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Téléphone (menu mobile)",
      "info": "Ex. 01 23 45 67 89"
    }
  ]
}
{% endschema %}
