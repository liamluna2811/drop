<section class="section section--{{ section.settings.background }}" id="bienfaits">
  <div class="page-width">
    <div class="section-header reveal">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow | escape }}</span>{%- endif -%}
      <h2>{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}{{ section.settings.text }}{%- endif -%}
    </div>
    <div class="benefits" style="--columns: {{ section.settings.columns }};">
      {%- for block in section.blocks -%}
        <div class="benefit reveal" {{ block.shopify_attributes }}>
          <div class="benefit__icon">{% render 'icon', name: block.settings.icon %}</div>
          <h3>{{ block.settings.title | escape }}</h3>
          <p>{{ block.settings.text | escape }}</p>
        </div>
      {%- endfor -%}
    </div>
    {%- if section.settings.button_label != blank -%}
      <div class="section-footer">
        <a href="{{ section.settings.button_link }}" class="{% if section.settings.background == 'dark' %}button button--light{% else %}button button--secondary{% endif %}">{{ section.settings.button_label | escape }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Bienfaits du Pilates",
  "max_blocks": 9,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "Pourquoi le Pilates" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Les bienfaits, séance après séance" },
    { "type": "richtext", "id": "text", "label": "Texte", "default": "<p>Une méthode douce mais exigeante, accessible à tous les âges et à tous les niveaux.</p>" },
    { "type": "range", "id": "columns", "label": "Colonnes (ordinateur)", "min": 2, "max": 4, "step": 1, "default": 3 },
    { "type": "text", "id": "button_label", "label": "Bouton" },
    { "type": "url", "id": "button_link", "label": "Lien du bouton" },
    { "type": "select", "id": "background", "label": "Fond", "default": "alt", "options": [
      { "value": "plain", "label": "Crème" }, { "value": "alt", "label": "Lin" }, { "value": "sand", "label": "Sable" }, { "value": "dark", "label": "Expresso" }
    ] }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Bienfait",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icône", "default": "posture", "options": [
      { "value": "posture", "label": "Posture" }, { "value": "core", "label": "Centre / sangle abdominale" },
      { "value": "flexibility", "label": "Souplesse" }, { "value": "breath", "label": "Respiration" },
      { "value": "mind", "label": "Esprit" }, { "value": "heart", "label": "Cœur" },
      { "value": "balance", "label": "Équilibre" }, { "value": "leaf", "label": "Feuille" },
      { "value": "spine", "label": "Colonne" }, { "value": "mat", "label": "Tapis" },
      { "value": "band", "label": "Bande élastique" }, { "value": "legging", "label": "Legging" },
      { "value": "bra", "label": "Brassière" }, { "value": "sock", "label": "Chaussette" },
      { "value": "home", "label": "Maison" }, { "value": "play", "label": "Vidéo" },
      { "value": "clock", "label": "Horloge" }, { "value": "calendar", "label": "Calendrier" },
      { "value": "truck", "label": "Livraison" }, { "value": "return", "label": "Retour" },
      { "value": "lock", "label": "Paiement sécurisé" }, { "value": "chat", "label": "Conseil" },
      { "value": "sparkle", "label": "Étoile" }
    ] },
        { "type": "text", "id": "title", "label": "Titre", "default": "Une meilleure posture" },
        { "type": "textarea", "id": "text", "label": "Texte", "default": "Description du bienfait." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bienfaits du Pilates",
      "blocks": [
        { "type": "benefit", "settings": { "icon": "posture", "title": "Une posture redressée", "text": "En renforçant les muscles profonds qui soutiennent la colonne, le Pilates aide à se tenir droit et à soulager le dos au quotidien." } },
        { "type": "benefit", "settings": { "icon": "core", "title": "Un centre solide", "text": "Le « powerhouse » — abdominaux, lombaires, fessiers et plancher pelvien — est au cœur de chaque mouvement." } },
        { "type": "benefit", "settings": { "icon": "flexibility", "title": "Souplesse & mobilité", "text": "Des mouvements amples et contrôlés qui allongent les muscles et redonnent de l'amplitude aux articulations." } },
        { "type": "benefit", "settings": { "icon": "breath", "title": "Une respiration consciente", "text": "La respiration guide l'effort : elle oxygène, apaise le système nerveux et améliore la concentration." } },
        { "type": "benefit", "settings": { "icon": "mind", "title": "Moins de stress", "text": "Se concentrer sur la précision du geste, c'est offrir une vraie pause à l'esprit." } },
        { "type": "benefit", "settings": { "icon": "balance", "title": "Équilibre & coordination", "text": "Un meilleur contrôle du corps dans l'espace, pour des gestes plus sûrs et une prévention des blessures." } }
      ]
    }
  ]
}
{% endschema %}
