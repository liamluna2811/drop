<section
  class="section{% if section.settings.surface %} section--surface{% endif %}"
  style="--section-pt: {{ section.settings.padding_top }}px; --section-pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="page-width">
    <div class="section-header section-header--center">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow | escape }}</span>{%- endif -%}
      <h2>{{ section.settings.heading | escape }}</h2>
    </div>
    <div class="testimonials">
      {%- for block in section.blocks -%}
        <figure class="testimonial" {{ block.shopify_attributes }}>
          <div class="testimonial__stars" role="img" aria-label="{{ 'sections.testimonials.rating' | t: rating: block.settings.rating }}">
            {%- for i in (1..block.settings.rating) -%}
              {%- render 'icon', name: 'star' -%}
            {%- endfor -%}
          </div>
          <blockquote>{{ block.settings.quote }}</blockquote>
          <figcaption>
            <strong>{{ block.settings.author | escape }}</strong>
            {%- if block.settings.product != blank %} · {{ block.settings.product | escape }}{% endif -%}
          </figcaption>
        </figure>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Avis clients",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Surtitre", "default": "Ils nous font confiance" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Ce que disent nos clients" },
    { "type": "checkbox", "id": "surface", "label": "Fond coloré", "default": true },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 8, "unit": "px", "label": "Marge haute", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 8, "unit": "px", "label": "Marge basse", "default": 80 }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Avis",
      "settings": [
        { "type": "range", "id": "rating", "min": 1, "max": 5, "step": 1, "label": "Note", "default": 5 },
        { "type": "richtext", "id": "quote", "label": "Avis", "default": "<p>Remplacez ce texte par un véritable avis client.</p>" },
        { "type": "text", "id": "author", "label": "Auteur", "default": "Prénom N." },
        { "type": "text", "id": "product", "label": "Produit acheté" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Avis clients",
      "blocks": [{ "type": "testimonial" }, { "type": "testimonial" }, { "type": "testimonial" }]
    }
  ]
}
{% endschema %}
