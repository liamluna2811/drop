<div class="page-width">
  <div class="collection-hero reveal">
    <span class="eyebrow">{{ 'collections.eyebrow' | t }}</span>
    <h1>{{ section.settings.heading | escape }}</h1>
  </div>
  <ul class="collection-list">
    {%- for collection in collections -%}
      {%- unless collection.handle == 'frontpage' -%}
        <li class="reveal">
          <a href="{{ collection.url }}" class="collection-card">
            {%- if collection.featured_image -%}
              {{ collection.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 25vw, 50vw', widths: '400, 600, 800' }}
            {%- else -%}
              {%- assign ph = forloop.index | modulo: 6 | plus: 1 -%}
              {{ 'collection-' | append: ph | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
            <span class="collection-card__title">{{ collection.title | escape }}<small>{{ 'collections.count' | t: count: collection.products_count }}</small></span>
          </a>
        </li>
      {%- endunless -%}
    {%- endfor -%}
  </ul>
</div>
<div style="height: 5rem"></div>

{% schema %}
{
  "name": "Liste des collections",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre", "default": "Toutes nos collections" }
  ]
}
{% endschema %}
