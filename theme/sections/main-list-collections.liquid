<div class="page-width">
  <header class="page-header">
    <h1>{{ section.settings.heading | escape }}</h1>
  </header>

  <ul class="grid" role="list" style="--cols-desktop: 3; --cols-mobile: 2;">
    {%- for collection in collections -%}
      {%- unless collection.handle == 'frontpage' -%}
        <li>
          <a href="{{ collection.url }}" class="collection-card">
            <div class="media media--portrait">
              {%- if collection.featured_image -%}
                {{ collection.featured_image | image_url: width: 1000 | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 33vw, 50vw', widths: '400, 600, 800, 1000', alt: collection.title }}
              {%- else -%}
                {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </div>
            <h2 class="collection-card__title">
              <span>
                {{ collection.title | escape }}
                <span class="collection-card__count">{{ 'sections.collection_list.products_count' | t: count: collection.products_count }}</span>
              </span>
              {%- render 'icon', name: 'arrow-right' -%}
            </h2>
          </a>
        </li>
      {%- endunless -%}
    {%- endfor -%}
  </ul>
</div>

<div style="height: 5rem"></div>

{% schema %}
{
  "name": "Liste des collections",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre", "default": "Toutes nos collections" }
  ]
}
{% endschema %}
