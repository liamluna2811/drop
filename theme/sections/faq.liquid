<section
  class="section{% if section.settings.surface %} section--surface{% endif %}"
  style="--section-pt: {{ section.settings.padding_top }}px; --section-pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="page-width">
    <div class="faq">
      <div class="section-header section-header--center">
        {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow | escape }}</span>{%- endif -%}
        <h2>{{ section.settings.heading | escape }}</h2>
      </div>
      <div class="accordion">
        {%- for block in section.blocks -%}
          <details class="accordion__item" {{ block.shopify_attributes }}>
            <summary>
              {{ block.settings.question | escape }}
              {%- render 'icon', name: 'plus' -%}
            </summary>
            <div class="accordion__content rte">{{ block.settings.answer }}</div>
          </details>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{%- if section.blocks.size > 0 -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- for block in section.blocks -%}
          {
            "@type": "Question",
            "name": {{ block.settings.question | json }},
            "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | strip_html | json }} }
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Questions fréquentes",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Surtitre", "default": "Besoin d'aide ?" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Questions fréquentes" },
    { "type": "checkbox", "id": "surface", "label": "Fond coloré", "default": false },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 8, "unit": "px", "label": "Marge haute", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 8, "unit": "px", "label": "Marge basse", "default": 80 }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Quels sont les délais de livraison ?" },
        { "type": "richtext", "id": "answer", "label": "Réponse", "default": "<p>Votre réponse ici.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Questions fréquentes",
      "blocks": [
        { "type": "question", "settings": { "question": "Quels sont les délais de livraison ?", "answer": "<p>Comptez en général 1 à 2 semaines entre votre commande et la livraison à domicile. Les frais de livraison sont calculés au moment du paiement.</p>" } },
        { "type": "question", "settings": { "question": "Faut-il monter le canapé ?", "answer": "<p>Dans la plupart des cas, non. Votre canapé est livré à domicile, compressé sous vide dans un carton : il suffit de le déballer et de le laisser reprendre sa forme pendant 72 heures.</p>" } },
        { "type": "question", "settings": { "question": "Combien de temps faut-il pour que le canapé prenne sa forme ?", "answer": "<p>Comptez 72 heures après le déballage pour que la mousse reprenne entièrement son volume. Évitez de vous asseoir dessus avant ce délai.</p>" } },
        { "type": "question", "settings": { "question": "Comment retourner un canapé ?", "answer": "<p>Vous disposez de 14 jours après réception pour changer d'avis. Contactez notre service client : nous vous indiquons la marche à suivre pour le retour et le remboursement.</p>" } },
        { "type": "question", "settings": { "question": "Comment entretenir mon canapé ?", "answer": "<p>Dépoussiérez-le régulièrement avec une brosse douce ou un aspirateur, et traitez les taches rapidement avec un chiffon légèrement humide. Évitez les produits abrasifs.</p>" } }
      ]
    }
  ]
}
{% endschema %}
