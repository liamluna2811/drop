<section class="section section--{{ section.settings.background }}" style="padding: 3rem 0;">
  <div class="page-width">
    <div class="trust">
      {%- for block in section.blocks -%}
        <div class="trust__item" {{ block.shopify_attributes }}>
          {% render 'icon', name: block.settings.icon %}
          <strong>{{ block.settings.title | escape }}</strong>
          <span>{{ block.settings.text | escape }}</span>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Réassurance",
  "max_blocks": 4,
  "settings": [
    { "type": "select", "id": "background", "label": "Fond", "default": "plain", "options": [
      { "value": "plain", "label": "Lait" }, { "value": "alt", "label": "Latte" }, { "value": "sand", "label": "Avoine" }, { "value": "matcha", "label": "Matcha doux" }
    ] }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Argument",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icône", "default": "truck", "options": [{"value": "matcha", "label": "Matcha"}, {"value": "bow", "label": "Nœud"}, {"value": "sun", "label": "Soleil"}, {"value": "moon", "label": "Lune"}, {"value": "posture", "label": "Posture"}, {"value": "core", "label": "Centre / sangle abdominale"}, {"value": "flexibility", "label": "Souplesse"}, {"value": "breath", "label": "Respiration"}, {"value": "mind", "label": "Esprit"}, {"value": "heart", "label": "Cœur"}, {"value": "balance", "label": "Équilibre"}, {"value": "leaf", "label": "Feuille"}, {"value": "spine", "label": "Colonne"}, {"value": "mat", "label": "Tapis"}, {"value": "band", "label": "Bande élastique"}, {"value": "legging", "label": "Legging"}, {"value": "bra", "label": "Brassière"}, {"value": "sock", "label": "Chaussette"}, {"value": "home", "label": "Maison"}, {"value": "play", "label": "Vidéo"}, {"value": "clock", "label": "Horloge"}, {"value": "calendar", "label": "Calendrier"}, {"value": "truck", "label": "Livraison"}, {"value": "return", "label": "Retour"}, {"value": "lock", "label": "Paiement sécurisé"}, {"value": "chat", "label": "Conseil"}, {"value": "sparkle", "label": "Étoile"}] },
        { "type": "text", "id": "title", "label": "Titre", "default": "Livraison offerte" },
        { "type": "text", "id": "text", "label": "Texte", "default": "Dès 60 € d'achat" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Réassurance",
      "blocks": [
        { "type": "item", "settings": { "icon": "truck", "title": "Livraison offerte", "text": "Dès 60 € d'achat" } },
        { "type": "item", "settings": { "icon": "return", "title": "Retours gratuits", "text": "Sous 30 jours" } },
        { "type": "item", "settings": { "icon": "lock", "title": "Paiement sécurisé", "text": "CB, PayPal, Apple Pay" } },
        { "type": "item", "settings": { "icon": "chat", "title": "Conseils personnalisés", "text": "Une question ? On vous répond" } }
      ]
    }
  ]
}
{% endschema %}
