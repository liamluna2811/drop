<div class="page-width" style="padding: 4rem 1.25rem 5rem;">
  <h1 style="text-align:center">{{ 'search.title' | t }}</h1>
  <form action="{{ routes.search_url }}" method="get" role="search" class="search-form">
    <label for="SearchInput" class="visually-hidden">{{ 'general.search' | t }}</label>
    <input id="SearchInput" type="search" name="q" value="{{ search.terms | escape }}" class="field__input" placeholder="{{ 'search.placeholder' | t }}">
    <input type="hidden" name="options[prefix]" value="last">
    <button type="submit" class="button">{{ 'general.search' | t }}</button>
  </form>

  {%- if search.performed -%}
    {%- paginate search.results by 16 -%}
      <p style="text-align:center; color: var(--color-text-soft)">{{ 'search.results_count' | t: count: search.results_count, terms: search.terms }}</p>
      {%- if search.results_count > 0 -%}
        <ul class="product-grid" style="margin-top: 2rem;">
          {%- for item in search.results -%}
            <li>
              {%- if item.object_type == 'product' -%}
                {% render 'product-card', product: item, index: forloop.index %}
              {%- else -%}
                <a href="{{ item.url }}" class="article-card">
                  <h3>{{ item.title | escape }}</h3>
                  <p>{{ item.content | strip_html | truncatewords: 20 }}</p>
                </a>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
        {%- if paginate.pages > 1 -%}{% render 'pagination', paginate: paginate %}{%- endif -%}
      {%- endif -%}
    {%- endpaginate -%}
  {%- endif -%}
</div>

{% schema %}
{ "name": "Recherche" }
{% endschema %}
