{%- comment -%}
  Vitrine catalogue : grand titre, raccourcis vers les catégories,
  barre d'outils (filtres, nombre de modèles, affichage) et grille de
  produits avec un modèle mis en avant et des encarts promotionnels.
{%- endcomment -%}
{%- liquid
  assign collection = section.settings.collection
  assign limit = section.settings.products_to_show
  assign chip_blocks = section.blocks | where: 'type', 'chip'
  assign promo_blocks = section.blocks | where: 'type', 'promo'
  assign collection_url = collection.url | default: routes.all_products_collection_url
  assign grid_id = 'Catalogue-' | append: section.id
-%}

<section
  class="section catalogue"
  style="--section-pt: {{ section.settings.padding_top }}px; --section-pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="page-width">
    <header class="catalogue__header">
      {%- if section.settings.heading != blank -%}
        <h2 class="catalogue__title">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="catalogue__intro rte">{{ section.settings.text }}</div>
      {%- endif -%}
    </header>

    {%- if section.settings.chips_menu != blank or chip_blocks.size > 0 -%}
      <nav class="chips" aria-label="{{ 'sections.catalogue.categories' | t }}">
        <ul class="chips__list" role="list">
          {%- if section.settings.chips_menu != blank -%}
            {%- for link in section.settings.chips_menu.links -%}
              <li><a href="{{ link.url }}" class="chip"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a></li>
            {%- endfor -%}
          {%- else -%}
            {%- for block in chip_blocks -%}
              {%- liquid
                assign chip_url = block.settings.link | default: block.settings.collection.url | default: '#'
                assign chip_label = block.settings.label | default: block.settings.collection.title
              -%}
              <li {{ block.shopify_attributes }}><a href="{{ chip_url }}" class="chip">{{ chip_label | escape }}</a></li>
            {%- endfor -%}
          {%- endif -%}
        </ul>
      </nav>
    {%- endif -%}

    {%- if section.settings.show_toolbar -%}
      <div class="catalogue__toolbar">
        <a href="{{ collection_url }}" class="button button--small">
          {{- 'collections.filters.title' | t -}}
          {%- render 'icon', name: 'filter' -%}
        </a>
        <div class="catalogue__toolbar-right">
          {%- if collection != blank -%}
            <span class="text-muted">{{ 'sections.catalogue.models_count' | t: count: collection.products_count }}</span>
          {%- endif -%}
          {% render 'grid-toggle', target: grid_id %}
        </div>
      </div>
    {%- endif -%}

    <ul
      id="{{ grid_id }}"
      class="grid catalogue__grid"
      role="list"
      style="--cols-desktop: {{ section.settings.columns }}; --cols-mobile: {{ section.settings.columns_mobile }};"
      data-grid
    >
      {%- liquid
        if collection != blank and collection.products_count > 0
          assign has_products = true
        else
          assign has_products = false
        endif
      -%}

      {%- if has_products -%}
        {%- for product in collection.products limit: limit -%}
          {%- for block in promo_blocks -%}
            {%- if block.settings.position == forloop.parentloop.index -%}
              {% render 'promo-tile', block: block %}
            {%- endif -%}
          {%- endfor -%}
          {%- if forloop.first and section.settings.feature_first -%}
            <li class="grid__item--featured">{% render 'product-card', product: product, show_secondary: true, featured: true %}</li>
          {%- else -%}
            <li>{% render 'product-card', product: product, show_secondary: true %}</li>
          {%- endif -%}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..limit) -%}
          {%- for block in promo_blocks -%}
            {%- if block.settings.position == i -%}
              {% render 'promo-tile', block: block %}
            {%- endif -%}
          {%- endfor -%}
          {%- if forloop.first and section.settings.feature_first -%}
            <li class="grid__item--featured">{% render 'product-card', product: blank, index: i, featured: true %}</li>
          {%- else -%}
            <li>{% render 'product-card', product: blank, index: i %}</li>
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
    </ul>

    {%- if section.settings.button_label != blank -%}
      <div class="catalogue__more">
        <a href="{{ collection_url }}" class="button button--secondary">{{ section.settings.button_label | escape }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Vitrine catalogue",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre", "default": "Nos canapés" },
    { "type": "richtext", "id": "text", "label": "Introduction (facultatif)" },
    {
      "type": "link_list",
      "id": "chips_menu",
      "label": "Raccourcis vers les catégories (menu)",
      "info": "Facultatif. Sinon, utilisez les blocs « Raccourci » ci-dessous."
    },
    { "type": "collection", "id": "collection", "label": "Collection affichée" },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 3,
      "max": 12,
      "step": 1,
      "label": "Nombre de produits",
      "default": 5
    },
    {
      "type": "checkbox",
      "id": "feature_first",
      "label": "Mettre en avant le premier produit (bannière sur toute la largeur)",
      "default": true
    },
    { "type": "checkbox", "id": "show_toolbar", "label": "Afficher la barre d'outils (filtres, nombre de modèles, affichage)", "default": true },
    {
      "type": "select",
      "id": "columns",
      "label": "Colonnes (ordinateur)",
      "options": [
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "4"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Colonnes (mobile)",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "1"
    },
    { "type": "text", "id": "button_label", "label": "Bouton sous la grille", "default": "Voir tous les canapés" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 8, "unit": "px", "label": "Marge haute", "default": 40 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 8, "unit": "px", "label": "Marge basse", "default": 80 }
  ],
  "blocks": [
    {
      "type": "chip",
      "name": "Raccourci",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "label", "label": "Texte (facultatif)" },
        { "type": "url", "id": "link", "label": "Lien personnalisé (facultatif)" }
      ]
    },
    {
      "type": "promo",
      "name": "Encart promotionnel",
      "limit": 4,
      "settings": [
        {
          "type": "range",
          "id": "position",
          "min": 1,
          "max": 12,
          "step": 1,
          "label": "Position dans la grille",
          "info": "L'encart s'affiche juste avant le produit n°…",
          "default": 6
        },
        {
          "type": "select",
          "id": "style",
          "label": "Style",
          "options": [
            { "value": "dark", "label": "Fond foncé" },
            { "value": "light", "label": "Fond clair" },
            { "value": "image", "label": "Image" }
          ],
          "default": "dark"
        },
        { "type": "image_picker", "id": "image", "label": "Image (style « Image »)" },
        { "type": "text", "id": "eyebrow", "label": "Surtitre", "default": "Offre de lancement" },
        { "type": "text", "id": "heading", "label": "Titre", "default": "Découvrez nos nouveautés" },
        { "type": "text", "id": "text", "label": "Texte" },
        { "type": "text", "id": "button_label", "label": "Texte du lien", "default": "Découvrir" },
        { "type": "url", "id": "link", "label": "Lien" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Vitrine catalogue",
      "blocks": [
        { "type": "chip", "settings": { "label": "Canapés convertibles" } },
        { "type": "chip", "settings": { "label": "Canapés d'angle" } },
        { "type": "chip", "settings": { "label": "Canapés droits" } },
        { "type": "chip", "settings": { "label": "Fauteuils" } }
      ]
    }
  ]
}
{% endschema %}
