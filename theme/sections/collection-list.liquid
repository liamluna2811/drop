{%- comment -%}
  Grille « Nos catégories » : canapés d'angle, convertibles, fauteuils…
{%- endcomment -%}
<section
  class="section{% if section.settings.surface %} section--surface{% endif %}"
  style="--section-pt: {{ section.settings.padding_top }}px; --section-pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="page-width">
    {%- if section.settings.heading != blank or section.settings.text != blank -%}
      <div class="section-header">
        <div>
          {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow | escape }}</span>{%- endif -%}
          <h2>{{ section.settings.heading | escape }}</h2>
          {%- if section.settings.text != blank -%}<p class="section-header__text">{{ section.settings.text | escape }}</p>{%- endif -%}
        </div>
        <a href="{{ routes.collections_url }}" class="link">
          {{- 'sections.collection_list.view_all' | t -}}
          {%- render 'icon', name: 'arrow-right' -%}
        </a>
      </div>
    {%- endif -%}

    <ul
      class="grid slider-mobile"
      role="list"
      style="--cols-desktop: {{ section.settings.columns }}; --cols-mobile: 2;"
    >
      {%- for block in section.blocks -%}
        {%- assign collection = block.settings.collection -%}
        <li {{ block.shopify_attributes }}>
          <a href="{{ collection.url | default: '#' }}" class="collection-card">
            <div class="media media--{{ section.settings.ratio }}">
              {%- liquid
                assign card_image = block.settings.image | default: collection.featured_image
              -%}
              {%- if card_image -%}
                {{
                  card_image
                  | image_url: width: 1200
                  | image_tag:
                    loading: 'lazy',
                    sizes: '(min-width: 990px) 33vw, 75vw',
                    widths: '400, 600, 800, 1000, 1200',
                    alt: collection.title
                    | escape
                }}
              {%- else -%}
                {%- assign placeholder_index = forloop.index | modulo: 4 | plus: 1 -%}
                {{ 'collection-' | append: placeholder_index | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </div>
            <h3 class="collection-card__title">
              <span>
                {{ block.settings.title | default: collection.title | default: 'Catégorie' | escape }}
                {%- if section.settings.show_count and collection.products_count > 0 -%}
                  <span class="collection-card__count">{{ 'sections.collection_list.products_count' | t: count: collection.products_count }}</span>
                {%- endif -%}
              </span>
              {%- render 'icon', name: 'arrow-right' -%}
            </h3>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Liste de catégories",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Surtitre", "default": "Nos catégories" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Trouvez le canapé qui vous ressemble" },
    { "type": "text", "id": "text", "label": "Texte" },
    {
      "type": "range",
      "id": "columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Colonnes (ordinateur)",
      "default": 4
    },
    {
      "type": "select",
      "id": "ratio",
      "label": "Format des images",
      "options": [
        { "value": "portrait", "label": "Portrait" },
        { "value": "square", "label": "Carré" },
        { "value": "landscape", "label": "Paysage" }
      ],
      "default": "portrait"
    },
    { "type": "checkbox", "id": "show_count", "label": "Afficher le nombre de produits", "default": true },
    { "type": "checkbox", "id": "surface", "label": "Fond coloré", "default": false },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 8, "unit": "px", "label": "Marge haute", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 8, "unit": "px", "label": "Marge basse", "default": 40 }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Catégorie",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "title", "label": "Titre personnalisé" },
        { "type": "image_picker", "id": "image", "label": "Image personnalisée" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Liste de catégories",
      "blocks": [
        { "type": "collection", "settings": { "title": "Canapés droits" } },
        { "type": "collection", "settings": { "title": "Canapés d'angle" } },
        { "type": "collection", "settings": { "title": "Canapés convertibles" } },
        { "type": "collection", "settings": { "title": "Fauteuils" } }
      ]
    }
  ]
}
{% endschema %}
