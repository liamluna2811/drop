{%- liquid
  assign image = section.settings.image
  assign image_mobile = section.settings.image_mobile | default: image
-%}

<section
  class="hero hero--{{ section.settings.height }} hero--align-{{ section.settings.alignment }}"
  style="--overlay: {{ section.settings.overlay | divided_by: 100.0 }}"
>
  <div class="hero__media">
    {%- if image != blank -%}
      <picture>
        {%- if section.settings.image_mobile != blank -%}
          <source
            media="(max-width: 749px)"
            srcset="{{ image_mobile | image_url: width: 750 }} 750w, {{ image_mobile | image_url: width: 1100 }} 1100w"
          >
        {%- endif -%}
        {{
          image
          | image_url: width: 3000
          | image_tag:
            loading: 'eager',
            fetchpriority: 'high',
            sizes: '100vw',
            widths: '750, 1100, 1500, 1920, 2400, 3000',
            alt: image.alt
            | escape
        }}
      </picture>
    {%- else -%}
      {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
    {%- endif -%}
  </div>

  <div class="page-width hero__content">
    <div class="hero__box">
      {%- if section.settings.eyebrow != blank -%}
        <span class="eyebrow hero__eyebrow">{{ section.settings.eyebrow | escape }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="h1">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="hero__text">{{ section.settings.text }}</div>
      {%- endif -%}
      <div class="hero__buttons">
        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="button button--light">
            {{- section.settings.button_label | escape -}}
          </a>
        {%- endif -%}
        {%- if section.settings.button_label_2 != blank -%}
          <a href="{{ section.settings.button_link_2 }}" class="button button--secondary">
            {{- section.settings.button_label_2 | escape -}}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Bannière principale",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Format paysage conseillé, 2400 × 1400 px minimum." },
    { "type": "image_picker", "id": "image_mobile", "label": "Image mobile (facultatif)", "info": "Format portrait conseillé." },
    {
      "type": "range",
      "id": "overlay",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Assombrissement de l'image",
      "default": 35
    },
    {
      "type": "select",
      "id": "height",
      "label": "Hauteur",
      "options": [
        { "value": "small", "label": "Petite" },
        { "value": "medium", "label": "Moyenne" },
        { "value": "large", "label": "Grande" }
      ],
      "default": "large"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Position du texte",
      "options": [
        { "value": "bottom-left", "label": "En bas à gauche" },
        { "value": "center", "label": "Au centre" }
      ],
      "default": "bottom-left"
    },
    { "type": "text", "id": "eyebrow", "label": "Surtitre", "default": "Nouvelle collection" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Le confort, simplement." },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texte",
      "default": "<p>Des canapés élégants et durables, conçus pour la vie de tous les jours.</p>"
    },
    { "type": "text", "id": "button_label", "label": "Bouton 1 — texte", "default": "Découvrir les canapés" },
    { "type": "url", "id": "button_link", "label": "Bouton 1 — lien" },
    { "type": "text", "id": "button_label_2", "label": "Bouton 2 — texte", "default": "Notre savoir-faire" },
    { "type": "url", "id": "button_link_2", "label": "Bouton 2 — lien" }
  ],
  "presets": [{ "name": "Bannière principale" }]
}
{% endschema %}
