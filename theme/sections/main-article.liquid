<article class="article">
  <p class="article__meta">{{ article.published_at | time_tag: format: 'date' }}{% if article.author %} · {{ article.author }}{% endif %}</p>
  <h1>{{ article.title | escape }}</h1>
  {%- if article.image -%}
    <div class="article__image">{{ article.image | image_url: width: 1400 | image_tag: sizes: '(min-width: 800px) 44rem, 100vw', widths: '600, 900, 1200, 1400' }}</div>
  {%- endif -%}
  <div class="rte">{{ article.content }}</div>
  <p style="text-align:center; margin-top: 3rem;"><a href="{{ blog.url }}" class="link-arrow">{{ 'blog.back' | t }}</a></p>
</article>

{% schema %}
{ "name": "Article" }
{% endschema %}
