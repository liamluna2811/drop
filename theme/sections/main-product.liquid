{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign product_form_id = 'ProductForm-' | append: section.id
  assign media_count = product.media.size
-%}

<section class="section" style="--section-pt: 24px; --section-pb: 64px;">
  <div class="page-width">
    <div class="product" data-product data-section-id="{{ section.id }}">
      {%- comment -%} Galerie {%- endcomment -%}
      <div class="product__gallery product__gallery--{{ section.settings.gallery_layout }}">
        <div class="gallery__main" data-gallery tabindex="0" aria-label="{{ 'products.product.gallery' | t }}">
          {%- for media in product.media -%}
            <div class="gallery__slide" data-media-id="{{ media.id }}" id="Slide-{{ section.id }}-{{ media.id }}">
              {%- case media.media_type -%}
                {%- when 'image' -%}
                  <div class="media media--{{ section.settings.media_ratio }}">
                    {%- if forloop.first -%}
                      {{ media | image_url: width: 1800 | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '(min-width: 990px) 55vw, 100vw', widths: '600, 900, 1200, 1500, 1800', alt: media.alt | default: product.title }}
                    {%- else -%}
                      {{ media | image_url: width: 1800 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 55vw, 100vw', widths: '600, 900, 1200, 1500, 1800', alt: media.alt | default: product.title }}
                    {%- endif -%}
                  </div>
                {%- when 'video' -%}
                  <div class="media media--{{ section.settings.media_ratio }}">
                    {{ media | video_tag: controls: true, muted: true, playsinline: true, image_size: '1200x' }}
                  </div>
                {%- when 'external_video' -%}
                  <div class="media media--wide">
                    {{ media | external_video_tag }}
                  </div>
                {%- when 'model' -%}
                  <div class="media media--square">
                    {{ media | model_viewer_tag }}
                  </div>
              {%- endcase -%}
            </div>
          {%- else -%}
            <div class="gallery__slide">
              <div class="media media--{{ section.settings.media_ratio }}">
                {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
              </div>
            </div>
          {%- endfor -%}
        </div>

        {%- if media_count > 1 -%}
          <div class="gallery__thumbs">
            {%- for media in product.media -%}
              <button
                type="button"
                class="gallery__thumb"
                data-thumb="{{ media.id }}"
                aria-label="{{ 'products.product.show_media' | t: index: forloop.index }}"
                {% if forloop.first %}aria-current="true"{% endif %}
              >
                <div class="media media--square">
                  {{ media.preview_image | image_url: width: 160 | image_tag: loading: 'lazy', alt: '' }}
                </div>
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} Informations produit {%- endcomment -%}
      <div class="product__info">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'breadcrumbs' -%}
              <nav class="product__breadcrumbs" aria-label="{{ 'general.breadcrumbs' | t }}" {{ block.shopify_attributes }}>
                <a href="{{ routes.root_url }}">{{ 'general.home' | t }}</a>
                {%- if collection -%}
                  / <a href="{{ collection.url }}">{{ collection.title | escape }}</a>
                {%- endif %}
                / <span aria-current="page">{{ product.title | escape }}</span>
              </nav>

            {%- when 'title' -%}
              <div {{ block.shopify_attributes }}>
                <h1 class="product__title">{{ product.title | escape }}</h1>
                {%- if product.metafields.custom.sous_titre != blank -%}
                  <p class="product__subtitle">{{ product.metafields.custom.sous_titre }}</p>
                {%- endif -%}
              </div>

            {%- when 'price' -%}
              <div class="product__price" data-product-price {{ block.shopify_attributes }}>
                {% render 'price', product: product, use_variant: true, class: 'price--large' %}
              </div>
              {%- if block.settings.show_tax_note -%}
                <p class="product__installments">{{ 'products.product.tax_included' | t }}</p>
              {%- endif -%}

            {%- when 'text' -%}
              <div class="product__block product__text rte" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>

            {%- when 'description' -%}
              {%- if product.description != blank -%}
                <div class="product__block product__text rte" {{ block.shopify_attributes }}>{{ product.description }}</div>
              {%- endif -%}

            {%- when 'variant_picker' -%}
              {%- unless product.has_only_default_variant -%}
                <div class="product__block variant-picker" data-variant-picker {{ block.shopify_attributes }}>
                  {%- for option in product.options_with_values -%}
                    {%- liquid
                      assign use_swatches = false
                      if block.settings.swatches
                        for value in option.values
                          if value.swatch.color or value.swatch.image
                            assign use_swatches = true
                            break
                          endif
                        endfor
                      endif
                    -%}
                    <fieldset>
                      <legend>{{ option.name }} : <span data-option-value>{{ option.selected_value }}</span></legend>
                      <div class="variant-picker__options">
                        {%- for value in option.values -%}
                          {%- assign input_id = section.id | append: '-' | append: option.position | append: '-' | append: forloop.index -%}
                          <input
                            type="radio"
                            id="{{ input_id }}"
                            name="{{ option.name | escape }}-{{ section.id }}"
                            value="{{ value | escape }}"
                            data-option-position="{{ option.position }}"
                            {% if option.selected_value == value %}checked{% endif %}
                            {% unless value.available %}class="is-unavailable"{% endunless %}
                          >
                          {%- if use_swatches -%}
                            {%- liquid
                              assign swatch_style = ''
                              if value.swatch.image
                                assign swatch_style = value.swatch.image | image_url: width: 80 | prepend: '--swatch: url(' | append: ')'
                              elsif value.swatch.color
                                assign swatch_style = value.swatch.color | prepend: '--swatch: '
                              endif
                            -%}
                            <label for="{{ input_id }}" class="variant-swatch" title="{{ value | escape }}">
                              <span style="{{ swatch_style }}"></span>
                              <span class="visually-hidden">{{ value | escape }}</span>
                            </label>
                          {%- else -%}
                            <label for="{{ input_id }}" class="variant-pill">{{ value | escape }}</label>
                          {%- endif -%}
                        {%- endfor -%}
                      </div>
                    </fieldset>
                  {%- endfor -%}
                  <script type="application/json" data-variants>
                    [
                      {%- for variant in product.variants -%}
                        {
                          "id": {{ variant.id }},
                          "options": {{ variant.options | json }},
                          "available": {{ variant.available | json }},
                          "price": {{ variant.price | money | json }},
                          "compare_at_price": {% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | money | json }}{% else %}null{% endif %},
                          "media_id": {% if variant.featured_media %}{{ variant.featured_media.id }}{% else %}null{% endif %},
                          "inventory": {% if variant.inventory_management == 'shopify' and variant.inventory_policy == 'deny' %}{{ variant.inventory_quantity }}{% else %}null{% endif %}
                        }{% unless forloop.last %},{% endunless %}
                      {%- endfor -%}
                    ]
                  </script>
                </div>
              {%- endunless -%}

            {%- when 'inventory' -%}
              {%- liquid
                if block.settings.in_stock_text != blank
                  assign in_stock_text = block.settings.in_stock_text | escape
                else
                  assign in_stock_text = 'products.product.inventory_in' | t
                endif
              -%}
              <div
                class="product__block"
                data-inventory
                data-low-threshold="{{ block.settings.low_threshold }}"
                data-in-text="{{ in_stock_text }}"
                data-low-text="{{ 'products.product.inventory_low_js' | t }}"
                data-out-text="{{ 'products.product.inventory_out' | t }}"
                {{ block.shopify_attributes }}
              >
                {%- liquid
                  assign qty = current_variant.inventory_quantity
                  assign tracked = false
                  if current_variant.inventory_management == 'shopify' and current_variant.inventory_policy == 'deny'
                    assign tracked = true
                  endif
                -%}
                {%- if current_variant.available == false -%}
                  <p class="inventory-note inventory-note--out" data-inventory-text>{{ 'products.product.inventory_out' | t }}</p>
                {%- elsif tracked and qty <= block.settings.low_threshold -%}
                  <p class="inventory-note inventory-note--low" data-inventory-text>{{ 'products.product.inventory_low' | t: count: qty }}</p>
                {%- else -%}
                  <p class="inventory-note" data-inventory-text>{{ in_stock_text }}</p>
                {%- endif -%}
              </div>

            {%- when 'buy_buttons' -%}
              <div class="product__block" {{ block.shopify_attributes }}>
                {%- form 'product', product, id: product_form_id, class: 'product-form', novalidate: 'novalidate', data-product-form: '' -%}
                  <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>
                  <div class="product-form__row">
                    {%- if block.settings.show_quantity -%}
                      <div class="quantity">
                        <button type="button" class="quantity__button" data-qty-minus aria-label="{{ 'products.product.quantity_decrease' | t }}">
                          {%- render 'icon', name: 'minus' -%}
                        </button>
                        <label for="Quantity-{{ section.id }}" class="visually-hidden">{{ 'products.product.quantity' | t }}</label>
                        <input class="quantity__input" type="number" id="Quantity-{{ section.id }}" name="quantity" value="1" min="1">
                        <button type="button" class="quantity__button" data-qty-plus aria-label="{{ 'products.product.quantity_increase' | t }}">
                          {%- render 'icon', name: 'plus' -%}
                        </button>
                      </div>
                    {%- endif -%}
                    <button
                      type="submit"
                      name="add"
                      class="button product-form__submit"
                      data-add-to-cart
                      {% unless current_variant.available %}disabled{% endunless %}
                    >
                      {%- if current_variant.available -%}
                        {{ 'products.product.add_to_cart' | t }}
                      {%- else -%}
                        {{ 'products.product.sold_out' | t }}
                      {%- endif -%}
                    </button>
                  </div>
                  <p class="product-form__error" role="alert" data-form-error></p>
                  {%- if block.settings.show_dynamic_checkout -%}
                    <div class="product__payment-buttons">{{ form | payment_button }}</div>
                  {%- endif -%}
                  {%- if block.settings.show_payment_terms -%}
                    <div class="product__installments" style="margin:1rem 0 0">{{ form | payment_terms }}</div>
                  {%- endif -%}
                {%- endform -%}
              </div>

            {%- when 'perks' -%}
              <div class="product__block product__perks" {{ block.shopify_attributes }}>
                {%- if block.settings.perk_1 != blank -%}
                  <p class="product__perk">{%- render 'icon', name: 'truck' -%}<span>{{ block.settings.perk_1 }}</span></p>
                {%- endif -%}
                {%- if block.settings.perk_2 != blank -%}
                  <p class="product__perk">{%- render 'icon', name: 'return' -%}<span>{{ block.settings.perk_2 }}</span></p>
                {%- endif -%}
                {%- if block.settings.perk_3 != blank -%}
                  <p class="product__perk">{%- render 'icon', name: 'shield' -%}<span>{{ block.settings.perk_3 }}</span></p>
                {%- endif -%}
                {%- if block.settings.perk_4 != blank -%}
                  <p class="product__perk">{%- render 'icon', name: 'swatch' -%}<span>{{ block.settings.perk_4 }}</span></p>
                {%- endif -%}
              </div>

            {%- when 'collapsible' -%}
              {%- liquid
                assign has_dimensions = false
                if block.settings.content_type == 'dimensions'
                  if product.metafields.custom.largeur != blank or product.metafields.custom.profondeur != blank or product.metafields.custom.hauteur != blank
                    assign has_dimensions = true
                  endif
                endif

                assign show_collapsible = false
                if block.settings.content != blank or block.settings.page != blank or has_dimensions
                  assign show_collapsible = true
                endif
                if block.settings.content_type == 'description' and product.description != blank
                  assign show_collapsible = true
                endif
              -%}
              {%- if show_collapsible -%}
                <div class="product__block accordion" {{ block.shopify_attributes }}>
                  <details class="accordion__item"{% if block.settings.open %} open{% endif %}>
                    <summary>
                      {{ block.settings.heading | escape }}
                      {%- render 'icon', name: 'plus' -%}
                    </summary>
                    <div class="accordion__content rte">
                      {%- if block.settings.content_type == 'description' -%}
                        {{ product.description }}
                      {%- elsif has_dimensions -%}
                        <table class="dimensions-table">
                          {%- if product.metafields.custom.largeur != blank -%}<tr><th>{{ 'products.dimensions.width' | t }}</th><td>{{ product.metafields.custom.largeur }}</td></tr>{%- endif -%}
                          {%- if product.metafields.custom.profondeur != blank -%}<tr><th>{{ 'products.dimensions.depth' | t }}</th><td>{{ product.metafields.custom.profondeur }}</td></tr>{%- endif -%}
                          {%- if product.metafields.custom.hauteur != blank -%}<tr><th>{{ 'products.dimensions.height' | t }}</th><td>{{ product.metafields.custom.hauteur }}</td></tr>{%- endif -%}
                          {%- if product.metafields.custom.hauteur_assise != blank -%}<tr><th>{{ 'products.dimensions.seat_height' | t }}</th><td>{{ product.metafields.custom.hauteur_assise }}</td></tr>{%- endif -%}
                          {%- if product.metafields.custom.profondeur_assise != blank -%}<tr><th>{{ 'products.dimensions.seat_depth' | t }}</th><td>{{ product.metafields.custom.profondeur_assise }}</td></tr>{%- endif -%}
                        </table>
                        {{ block.settings.content }}
                      {%- else -%}
                        {{ block.settings.content }}
                        {{ block.settings.page.content }}
                      {%- endif -%}
                    </div>
                  </details>
                </div>
              {%- endif -%}

            {%- when '@app' -%}
              <div class="product__block">{% render block %}</div>
          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

<script type="application/ld+json">
  {{ product | structured_data }}
</script>

{% schema %}
{
  "name": "Fiche produit",
  "tag": "div",
  "class": "section-main-product",
  "settings": [
    {
      "type": "select",
      "id": "gallery_layout",
      "label": "Galerie (ordinateur)",
      "options": [
        { "value": "slider", "label": "Image principale + miniatures" },
        { "value": "grid", "label": "Grille d'images" }
      ],
      "default": "slider"
    },
    {
      "type": "select",
      "id": "media_ratio",
      "label": "Format des images",
      "options": [
        { "value": "landscape", "label": "Paysage (4:3)" },
        { "value": "square", "label": "Carré" },
        { "value": "portrait", "label": "Portrait" }
      ],
      "default": "landscape"
    }
  ],
  "blocks": [
    { "type": "@app" },
    { "type": "breadcrumbs", "name": "Fil d'Ariane", "limit": 1, "settings": [] },
    { "type": "title", "name": "Titre", "limit": 1, "settings": [] },
    {
      "type": "price",
      "name": "Prix",
      "limit": 1,
      "settings": [
        { "type": "checkbox", "id": "show_tax_note", "label": "Afficher « TVA incluse »", "default": true }
      ]
    },
    {
      "type": "variant_picker",
      "name": "Sélecteur d'options",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "swatches",
          "label": "Afficher des pastilles de couleur",
          "info": "Utilise les pastilles définies dans les options produit (Shopify > Produits > Options).",
          "default": true
        }
      ]
    },
    {
      "type": "inventory",
      "name": "Disponibilité",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "in_stock_text", "label": "Texte « en stock »", "default": "En stock — livré sous 1 à 2 semaines" },
        { "type": "range", "id": "low_threshold", "min": 1, "max": 10, "step": 1, "label": "Seuil « stock faible »", "default": 3 }
      ]
    },
    {
      "type": "buy_buttons",
      "name": "Boutons d'achat",
      "limit": 1,
      "settings": [
        { "type": "checkbox", "id": "show_quantity", "label": "Afficher la quantité", "default": false },
        { "type": "checkbox", "id": "show_dynamic_checkout", "label": "Afficher les boutons de paiement rapide", "default": false },
        { "type": "checkbox", "id": "show_payment_terms", "label": "Afficher le paiement en plusieurs fois (Shop Pay)", "default": true }
      ]
    },
    { "type": "description", "name": "Description", "limit": 1, "settings": [] },
    {
      "type": "text",
      "name": "Texte",
      "settings": [
        { "type": "richtext", "id": "text", "label": "Texte", "default": "<p>Texte court</p>" }
      ]
    },
    {
      "type": "perks",
      "name": "Avantages",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "perk_1", "label": "Livraison", "default": "Livré compressé : passe partout, sans montage" },
        { "type": "text", "id": "perk_2", "label": "Retours", "default": "14 jours pour changer d'avis" },
        { "type": "text", "id": "perk_3", "label": "Garantie", "default": "Structure garantie 10 ans" },
        { "type": "text", "id": "perk_4", "label": "Échantillons", "default": "Échantillons de tissu gratuits sur demande" }
      ]
    },
    {
      "type": "collapsible",
      "name": "Onglet déroulant",
      "settings": [
        { "type": "text", "id": "heading", "label": "Titre", "default": "Livraison & retours" },
        {
          "type": "select",
          "id": "content_type",
          "label": "Contenu",
          "options": [
            { "value": "custom", "label": "Texte ou page ci-dessous" },
            { "value": "description", "label": "Description du produit" },
            { "value": "dimensions", "label": "Dimensions (métachamps)" }
          ],
          "default": "custom"
        },
        { "type": "richtext", "id": "content", "label": "Texte" },
        { "type": "page", "id": "page", "label": "Contenu d'une page" },
        { "type": "checkbox", "id": "open", "label": "Ouvert par défaut", "default": false }
      ]
    }
  ]
}
{% endschema %}
