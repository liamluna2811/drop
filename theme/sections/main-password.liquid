<div class="password">
  <div class="password__inner">
    <span class="eyebrow">{{ 'password.eyebrow' | t }}</span>
    <h1>{{ shop.name }}</h1>
    {%- if shop.password_message != blank -%}<p>{{ shop.password_message }}</p>{%- endif -%}
    {%- form 'customer' -%}
      <input type="hidden" name="contact[tags]" value="prospect,password page">
      <input type="email" name="contact[email]" class="field__input" placeholder="{{ 'newsletter.label' | t }}" required>
      <button type="submit" class="button">{{ 'password.notify' | t }}</button>
      {%- if form.posted_successfully? -%}<p class="form-message" style="flex-basis:100%">{{ 'newsletter.success' | t }}</p>{%- endif -%}
    {%- endform -%}
    <details style="margin-top: 2.5rem;">
      <summary style="cursor:pointer; font-size:.9rem;">{{ 'password.owner' | t }}</summary>
      {%- form 'storefront_password' -%}
        {{ form.errors | default_errors }}
        <input type="password" name="password" class="field__input" placeholder="{{ 'password.password' | t }}" autocomplete="current-password">
        <button type="submit" class="button button--secondary">{{ 'password.enter' | t }}</button>
      {%- endform -%}
    </details>
  </div>
</div>

{% schema %}
{ "name": "Mot de passe" }
{% endschema %}
