<div class="password">
  <p class="h2">{{ shop.name }}</p>
  {%- if section.settings.text != blank -%}
    <div class="rte text-muted" style="margin-bottom:2rem">{{ section.settings.text }}</div>
  {%- endif -%}

  {%- form 'customer' -%}
    <input type="hidden" name="contact[tags]" value="newsletter, ouverture">
    {%- if form.posted_successfully? -%}
      <p class="form-message" role="status">{{ 'newsletter.success' | t }}</p>
    {%- else -%}
      <div class="newsletter__form">
        <label for="PasswordNewsletter" class="visually-hidden">{{ 'newsletter.label' | t }}</label>
        <input id="PasswordNewsletter" class="input" type="email" name="contact[email]" placeholder="{{ 'newsletter.placeholder' | t }}" required>
        <button type="submit" class="button">{{ 'password.notify' | t }}</button>
      </div>
    {%- endif -%}
  {%- endform -%}

  <details style="margin-top:3rem">
    <summary class="link" style="cursor:pointer">{{ 'password.enter' | t }}</summary>
    {%- form 'storefront_password', style: 'margin-top:1rem' -%}
      {%- if form.errors -%}
        <p class="form-message form-message--error" role="alert">{{ 'password.error' | t }}</p>
      {%- endif -%}
      <div class="newsletter__form">
        <label for="StorePassword" class="visually-hidden">{{ 'password.label' | t }}</label>
        <input id="StorePassword" class="input" type="password" name="password" autocomplete="current-password" placeholder="{{ 'password.label' | t }}">
        <button type="submit" class="button button--secondary">{{ 'password.submit' | t }}</button>
      </div>
    {%- endform -%}
  </details>
</div>

{% schema %}
{
  "name": "Page mot de passe",
  "settings": [
    {
      "type": "richtext",
      "id": "text",
      "label": "Message",
      "default": "<p>Notre boutique ouvre très bientôt. Laissez-nous votre e-mail pour être prévenu(e) de l'ouverture.</p>"
    }
  ]
}
{% endschema %}
