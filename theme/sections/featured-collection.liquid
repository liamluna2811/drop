{%- liquid
  assign collection = section.settings.collection
  assign limit = section.settings.products_to_show
-%}

<section
  class="section{% if section.settings.surface %} section--surface{% endif %}"
  style="--section-pt: {{ section.settings.padding_top }}px; --section-pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="page-width">
    <div class="section-header">
      <div>
        {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow | escape }}</span>{%- endif -%}
        <h2>{{ section.settings.heading | default: collection.title | escape }}</h2>
      </div>
      {%- if collection != blank -%}
        <a href="{{ collection.url }}" class="link">
          {{- 'sections.featured_collection.view_all' | t -}}
          {%- render 'icon', name: 'arrow-right' -%}
        </a>
      {%- endif -%}
    </div>

    <ul
      class="grid{% if section.settings.slider_mobile %} slider-mobile{% endif %}"
      role="list"
      style="--cols-desktop: {{ section.settings.columns }}; --cols-mobile: 2;"
    >
      {%- if collection != blank and collection.products_count > 0 -%}
        {%- for product in collection.products limit: limit -%}
          <li>{% render 'product-card', product: product, show_secondary: true %}</li>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..limit) -%}
          <li>{% render 'product-card', product: blank, index: i %}</li>
        {%- endfor -%}
      {%- endif -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Produits mis en avant",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Surtitre", "default": "Les plus aimés" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Nos best-sellers" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "label": "Nombre de produits",
      "default": 4
    },
    {
      "type": "range",
      "id": "columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Colonnes (ordinateur)",
      "default": 4
    },
    { "type": "checkbox", "id": "slider_mobile", "label": "Défilement horizontal sur mobile", "default": true },
    { "type": "checkbox", "id": "surface", "label": "Fond coloré", "default": false },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 8, "unit": "px", "label": "Marge haute", "default": 40 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 8, "unit": "px", "label": "Marge basse", "default": 80 }
  ],
  "presets": [{ "name": "Produits mis en avant" }]
}
{% endschema %}
