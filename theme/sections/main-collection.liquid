{%- liquid
  assign sort_by = collection.sort_by | default: collection.default_sort_by
  assign per_page = section.settings.products_per_page
-%}
<div class="page-width">
  <div class="collection-hero reveal">
    <span class="eyebrow">{{ 'collections.eyebrow' | t }}</span>
    <h1>{{ collection.title | escape }}</h1>
    {%- if collection.description != blank -%}<div class="rte">{{ collection.description }}</div>{%- endif -%}
  </div>

  {%- paginate collection.products by per_page -%}
    <div class="collection-toolbar">
      <form class="facets" id="FacetsForm">
        {%- if section.settings.show_filters -%}
          {%- for filter in collection.filters -%}
            <details>
              <summary class="chip{% if filter.active_values.size > 0 %} is-active{% endif %}">
                {{ filter.label | escape }}{% if filter.active_values.size > 0 %} ({{ filter.active_values.size }}){% endif %}
              </summary>
              <div class="facets__panel">
                {%- case filter.type -%}
                  {%- when 'list', 'boolean' -%}
                    {%- for value in filter.values -%}
                      <label>
                        <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}"{% if value.active %} checked{% endif %}{% if value.count == 0 and value.active == false %} disabled{% endif %} onchange="this.form.submit()">
                        {{ value.label | escape }} <span style="color: var(--color-text-soft)">({{ value.count }})</span>
                      </label>
                    {%- endfor -%}
                  {%- when 'price_range' -%}
                    <div class="facets__price">
                      <input type="number" name="{{ filter.min_value.param_name }}" value="{% if filter.min_value.value %}{{ filter.min_value.value | money_without_currency | replace: ',', '.' }}{% endif %}" placeholder="0" min="0" aria-label="Min">
                      <input type="number" name="{{ filter.max_value.param_name }}" value="{% if filter.max_value.value %}{{ filter.max_value.value | money_without_currency | replace: ',', '.' }}{% endif %}" placeholder="{{ filter.range_max | money_without_currency | replace: ',', '.' }}" min="0" aria-label="Max">
                    </div>
                    <button type="submit" class="button" style="margin-top: .75rem; padding: .6rem 1.25rem;">{{ 'collections.apply' | t }}</button>
                {%- endcase -%}
              </div>
            </details>
          {%- endfor -%}
          {%- liquid
            assign has_active = false
            for filter in collection.filters
              if filter.active_values.size > 0 or filter.min_value.value or filter.max_value.value
                assign has_active = true
              endif
            endfor
          -%}
          {%- if has_active -%}
            <a href="{{ collection.url }}?sort_by={{ sort_by }}" class="chip">{{ 'collections.clear' | t }}</a>
          {%- endif -%}
        {%- endif -%}
        <input type="hidden" name="sort_by" value="{{ sort_by }}">
      </form>

      <div style="display:flex; align-items:center; gap:.75rem;">
        <span style="font-size:.9rem; color: var(--color-text-soft)">{{ 'collections.count' | t: count: collection.products_count }}</span>
        <label for="SortBy" class="visually-hidden">{{ 'collections.sort' | t }}</label>
        <select id="SortBy" class="select" data-sort-select>
          {%- for option in collection.sort_options -%}
            <option value="{{ option.value }}"{% if option.value == sort_by %} selected{% endif %}>{{ option.name }}</option>
          {%- endfor -%}
        </select>
      </div>
    </div>

    {%- if collection.products.size > 0 -%}
      <ul class="product-grid" style="--columns: {{ section.settings.columns }};">
        {%- for product in collection.products -%}
          <li class="reveal">{% render 'product-card', product: product, index: forloop.index %}</li>
        {%- endfor -%}
      </ul>
    {%- else -%}
      <div class="empty-state">
        <p>{{ 'collections.empty' | t }}</p>
        <a href="{{ routes.all_products_collection_url }}" class="button button--secondary">{{ 'general.continue_shopping' | t }}</a>
      </div>
    {%- endif -%}

    {%- if paginate.pages > 1 -%}
      {% render 'pagination', paginate: paginate %}
    {%- endif -%}
  {%- endpaginate -%}
</div>
<div style="height: 5rem"></div>

{% schema %}
{
  "name": "Collection",
  "settings": [
    { "type": "range", "id": "products_per_page", "label": "Produits par page", "min": 8, "max": 48, "step": 4, "default": 16 },
    { "type": "range", "id": "columns", "label": "Colonnes (ordinateur)", "min": 2, "max": 5, "step": 1, "default": 4 },
    { "type": "checkbox", "id": "show_filters", "label": "Afficher les filtres", "default": true, "info": "Configurez les filtres dans l'app Search & Discovery." }
  ]
}
{% endschema %}
