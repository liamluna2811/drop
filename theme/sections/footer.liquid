<footer class="site-footer">
  <div class="page-width">
    <div class="site-footer__grid">
      <div>
        <div class="site-footer__brand">{{ settings.brand_name | default: shop.name }}</div>
        {%- if section.settings.about != blank -%}
          <div class="site-footer__about">{{ section.settings.about }}</div>
        {%- endif -%}
        <div class="site-footer__social">
          {%- if settings.social_instagram != blank -%}<a href="{{ settings.social_instagram }}" aria-label="Instagram" target="_blank" rel="noopener">{% render 'icon', name: 'instagram' %}</a>{%- endif -%}
          {%- if settings.social_tiktok != blank -%}<a href="{{ settings.social_tiktok }}" aria-label="TikTok" target="_blank" rel="noopener">{% render 'icon', name: 'tiktok' %}</a>{%- endif -%}
          {%- if settings.social_pinterest != blank -%}<a href="{{ settings.social_pinterest }}" aria-label="Pinterest" target="_blank" rel="noopener">{% render 'icon', name: 'pinterest' %}</a>{%- endif -%}
          {%- if settings.social_youtube != blank -%}<a href="{{ settings.social_youtube }}" aria-label="YouTube" target="_blank" rel="noopener">{% render 'icon', name: 'youtube' %}</a>{%- endif -%}
        </div>
      </div>

      {%- for block in section.blocks -%}
        <div {{ block.shopify_attributes }}>
          <h4>{{ block.settings.heading | escape }}</h4>
          <ul>
            {%- for link in block.settings.menu.links -%}
              <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endfor -%}
    </div>

    <div class="site-footer__bottom">
      <span>&copy; {{ 'now' | date: '%Y' }} {{ settings.brand_name | default: shop.name }} · {{ powered_by_link }}</span>
      <nav class="site-footer__legal" aria-label="{{ 'sections.footer.legal' | t }}">
        {%- for link in section.settings.legal_menu.links -%}
          <a href="{{ link.url }}">{{ link.title | escape }}</a>
        {%- endfor -%}
        <button type="button" class="site-footer__cookies" data-open-cookies>{{ 'sections.footer.manage_cookies' | t }}</button>
      </nav>
      {%- if section.settings.show_payment_icons -%}
        <ul class="payment-icons" aria-label="{{ 'sections.footer.payment' | t }}">
          {%- for type in shop.enabled_payment_types -%}
            <li>{{ type | payment_type_svg_tag }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Pied de page",
  "class": "section-footer-wrapper",
  "max_blocks": 4,
  "settings": [
    { "type": "richtext", "id": "about", "label": "Texte de présentation", "default": "<p>Des accessoires et vêtements de Pilates choisis avec soin, pour bouger en douceur, chez vous comme au studio.</p>" },
    { "type": "checkbox", "id": "show_payment_icons", "label": "Afficher les moyens de paiement", "default": true },
    { "type": "link_list", "id": "legal_menu", "label": "Liens légaux (bas de page)", "default": "footer", "info": "Mentions légales, CGV, CGU, confidentialité, cookies, retours. Un lien « Gérer les cookies » est ajouté automatiquement." }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu",
      "settings": [
        { "type": "text", "id": "heading", "label": "Titre", "default": "Boutique" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    }
  ]
}
{% endschema %}
