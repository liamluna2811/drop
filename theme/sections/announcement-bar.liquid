{%- if section.settings.text != blank -%}
  <div class="announcement" role="region" aria-label="{{ 'sections.announcement' | t }}">
    {%- if section.settings.link != blank -%}
      <a href="{{ section.settings.link }}">{{ section.settings.text | escape }}</a>
    {%- else -%}
      {{ section.settings.text | escape }}
    {%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Barre d'annonce",
  "class": "section-announcement",
  "settings": [
    { "type": "text", "id": "text", "label": "Texte", "default": "Livraison offerte dès 60 € · Retours sous 30 jours" },
    { "type": "url", "id": "link", "label": "Lien" }
  ],
  "presets": [{ "name": "Barre d'annonce" }]
}
{% endschema %}
