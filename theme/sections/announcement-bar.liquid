{%- if section.blocks.size > 0 -%}
  <div class="announcement-bar" role="region" aria-label="{{ 'general.announcement' | t }}" {{ section.shopify_attributes }}>
    <div class="page-width announcement-bar__inner">
      <div class="announcement-bar__messages" data-announcement data-interval="{{ section.settings.interval }}">
        {%- for block in section.blocks -%}
          <p class="announcement-bar__message" {{ block.shopify_attributes }}{% unless forloop.first %} aria-hidden="true"{% endunless %}>
            {%- if block.settings.link != blank -%}
              <a href="{{ block.settings.link }}">{{ block.settings.text | escape }}</a>
            {%- else -%}
              {{ block.settings.text | escape }}
            {%- endif -%}
          </p>
        {%- endfor -%}
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Bandeau d'annonce",
  "max_blocks": 5,
  "settings": [
    {
      "type": "range",
      "id": "interval",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "Changement de message toutes les",
      "default": 5
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Message",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Texte",
          "default": "Livraison à domicile partout en France"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Lien"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bandeau d'annonce",
      "blocks": [{ "type": "announcement" }]
    }
  ]
}
{% endschema %}
