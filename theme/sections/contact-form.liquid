<div class="page-width page-narrow contact-form">
  {%- if section.settings.heading != blank -%}
    <h2>{{ section.settings.heading | escape }}</h2>
  {%- endif -%}

  {%- form 'contact', id: 'ContactForm' -%}
    {%- if form.posted_successfully? -%}
      <p class="form-message" role="status">{{ 'contact.success' | t }}</p>
    {%- elsif form.errors -%}
      <div class="form-message form-message--error" role="alert">
        {{ 'contact.error' | t }}
        {{ form.errors | default_errors }}
      </div>
    {%- endif -%}

    <div class="grid-2">
      <div class="field">
        <label for="ContactName">{{ 'contact.name' | t }}</label>
        <input class="input" type="text" id="ContactName" name="contact[{{ 'contact.name' | t }}]" autocomplete="name" value="{{ form.name }}">
      </div>
      <div class="field">
        <label for="ContactEmail">{{ 'contact.email' | t }} *</label>
        <input class="input" type="email" id="ContactEmail" name="contact[email]" autocomplete="email" value="{{ form.email }}" required>
      </div>
    </div>
    <div class="field">
      <label for="ContactPhone">{{ 'contact.phone' | t }}</label>
      <input class="input" type="tel" id="ContactPhone" name="contact[{{ 'contact.phone' | t }}]" autocomplete="tel" value="{{ form.phone }}">
    </div>
    <div class="field">
      <label for="ContactOrder">{{ 'contact.order' | t }}</label>
      <input class="input" type="text" id="ContactOrder" name="contact[{{ 'contact.order' | t }}]">
    </div>
    <div class="field">
      <label for="ContactMessage">{{ 'contact.message' | t }} *</label>
      <textarea class="textarea" id="ContactMessage" name="contact[body]" required>{{ form.body }}</textarea>
    </div>
    <button type="submit" class="button">{{ 'contact.send' | t }}</button>
  {%- endform -%}
</div>

<div style="height: 5rem"></div>

{% schema %}
{
  "name": "Formulaire de contact",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre", "default": "Écrivez-nous" }
  ],
  "presets": [{ "name": "Formulaire de contact" }]
}
{% endschema %}
