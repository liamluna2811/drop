    "faq": {
      "type": "faq",
      "blocks": {
        "q-1": {
          "type": "question",
          "settings": {
            "question": "Quels sont les délais de livraison ?",
            "answer": "<p>Les modèles en stock sont livrés sous 1 à 2 semaines. Les modèles fabriqués sur commande sont livrés sous 6 à 8 semaines. Le délai exact est indiqué sur chaque fiche produit.</p>"
          }
        },
        "q-2": {
          "type": "question",
          "settings": {
            "question": "La livraison comprend-elle l'installation ?",
            "answer": "<p>Oui. Nos livreurs installent votre canapé dans la pièce de votre choix et repartent avec les emballages.</p>"
          }
        },
        "q-3": {
          "type": "question",
          "settings": {
            "question": "Puis-je recevoir des échantillons de tissu ?",
            "answer": "<p>Bien sûr. Contactez-nous pour recevoir gratuitement jusqu'à 5 échantillons avant de commander.</p>"
          }
        },
        "q-4": {
          "type": "question",
          "settings": {
            "question": "Comment retourner un canapé ?",
            "answer": "<p>Vous disposez de 30 jours après la livraison pour changer d'avis. Contactez notre service client : nous organisons l'enlèvement à domicile.</p>"
          }
        },
        "q-5": {
          "type": "question",
          "settings": {
            "question": "Les housses sont-elles lavables ?",
            "answer": "<p>La plupart de nos modèles sont déhoussables. Les consignes d'entretien sont précisées sur chaque fiche produit.</p>"
          }
        }
      },
