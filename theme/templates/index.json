    "benefits": {
      "type": "benefits",
      "blocks": {
        "b1": {
          "type": "benefit",
          "settings": {
            "icon": "posture",
            "title": "Une posture redressée",
            "text": "En renforçant les muscles profonds qui soutiennent la colonne, le Pilates aide à se tenir droit et à soulager le dos au quotidien."
          }
        },
        "b2": {
          "type": "benefit",
          "settings": {
            "icon": "core",
            "title": "Un centre solide",
            "text": "Le « powerhouse » — abdominaux, lombaires, fessiers et plancher pelvien — est au cœur de chaque mouvement."
          }
        },
        "b3": {
          "type": "benefit",
          "settings": {
            "icon": "flexibility",
            "title": "Souplesse & mobilité",
            "text": "Des mouvements amples et contrôlés qui allongent les muscles et redonnent de l'amplitude aux articulations."
          }
        },
        "b4": {
          "type": "benefit",
          "settings": {
            "icon": "breath",
            "title": "Une respiration consciente",
            "text": "La respiration guide l'effort : elle oxygène, apaise le système nerveux et améliore la concentration."
          }
        },
        "b5": {
          "type": "benefit",
          "settings": {
            "icon": "mind",
            "title": "Moins de stress",
            "text": "Se concentrer sur la précision du geste, c'est offrir une vraie pause à l'esprit."
          }
        },
        "b6": {
          "type": "benefit",
          "settings": {
            "icon": "balance",
            "title": "Équilibre & coordination",
            "text": "Un meilleur contrôle du corps dans l'espace, pour des gestes plus sûrs et moins de risques de blessure."
          }
        }
      },
