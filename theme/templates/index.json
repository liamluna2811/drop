    "story": {
      "type": "pilates-story",
      "blocks": {
        "e1": {
          "type": "event",
          "settings": {
            "year": "1883",
            "title": "Une enfance fragile",
            "text": "Joseph Pilates naît près de Düsseldorf, en Allemagne. Enfant asthmatique et de santé fragile, il se passionne pour la gymnastique, la boxe et l'anatomie pour renforcer son corps."
          }
        },
        "e2": {
          "type": "event",
          "settings": {
            "year": "1914",
            "title": "Naissance d'une méthode",
            "text": "Installé en Angleterre, il est interné pendant la Première Guerre mondiale. Il fait travailler ses codétenus et fixe des ressorts aux lits de l'infirmerie : l'ancêtre du Reformer est né."
          }
        },
        "e3": {
          "type": "event",
          "settings": {
            "year": "1926",
            "title": "Le studio de New York",
            "text": "Avec sa femme Clara, il ouvre un studio sur la 8e Avenue. Les danseurs et chorégraphes adoptent vite sa méthode pour se renforcer et se rééduquer."
          }
        },
        "e4": {
          "type": "event",
          "settings": {
            "year": "Aujourd'hui",
            "title": "Une pratique universelle",
            "text": "La méthode est pratiquée par des millions de personnes, au sol comme sur machine, du sportif de haut niveau à la rééducation."
          }
        }
      },
