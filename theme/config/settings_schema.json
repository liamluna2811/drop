[
  {
    "name": "theme_info",
    "theme_name": "Canapé",
    "theme_version": "1.0.0",
    "theme_author": "Sur mesure",
    "theme_documentation_url": "https://help.shopify.com/fr/manual/online-store/themes",
    "theme_support_url": "https://help.shopify.com/fr"
  },
  {
    "name": "Couleurs",
    "settings": [
      { "type": "paragraph", "content": "Palette neutre et chaude par défaut. Gardez peu de couleurs pour un rendu sobre." },
      { "type": "color", "id": "color_background", "label": "Fond", "default": "#FAF8F5" },
      { "type": "color", "id": "color_surface", "label": "Fond secondaire (sections colorées)", "default": "#F1ECE5" },
      { "type": "color", "id": "color_text", "label": "Texte", "default": "#1F1C19" },
      { "type": "color", "id": "color_text_muted", "label": "Texte secondaire", "default": "#6B635A" },
      { "type": "color", "id": "color_border", "label": "Bordures", "default": "#E4DDD4" },
      { "type": "color", "id": "color_button", "label": "Boutons", "default": "#1F1C19" },
      { "type": "color", "id": "color_button_text", "label": "Texte des boutons", "default": "#FFFFFF" },
      { "type": "color", "id": "color_accent", "label": "Accent (étoiles d'avis)", "default": "#8A6A4F" },
      { "type": "color", "id": "color_sale", "label": "Promotions et erreurs", "default": "#A4442E" }
    ]
  },
  {
    "name": "Typographie",
    "settings": [
      { "type": "font_picker", "id": "type_heading_font", "label": "Police des titres", "default": "jost_n4" },
      {
        "type": "range",
        "id": "heading_scale",
        "min": 80,
        "max": 130,
        "step": 5,
        "unit": "%",
        "label": "Taille des titres",
        "default": 100
      },
      { "type": "font_picker", "id": "type_body_font", "label": "Police du texte", "default": "jost_n4" }
    ]
  },
  {
    "name": "Mise en page",
    "settings": [
      {
        "type": "range",
        "id": "page_width",
        "min": 1100,
        "max": 1600,
        "step": 50,
        "unit": "px",
        "label": "Largeur maximale de la page",
        "default": 1400
      },
      {
        "type": "range",
        "id": "corner_radius",
        "min": 0,
        "max": 16,
        "step": 1,
        "unit": "px",
        "label": "Arrondi des angles",
        "default": 2
      },
      { "type": "image_picker", "id": "favicon", "label": "Favicon", "info": "32 × 32 px" }
    ]
  },
  {
    "name": "Cartes produit",
    "settings": [
      {
        "type": "select",
        "id": "card_ratio",
        "label": "Format des images",
        "options": [
          { "value": "landscape", "label": "Paysage (conseillé pour les canapés)" },
          { "value": "square", "label": "Carré" },
          { "value": "portrait", "label": "Portrait" }
        ],
        "default": "landscape"
      },
      { "type": "checkbox", "id": "card_show_type", "label": "Afficher le type de produit sous le titre", "default": true }
    ]
  },
  {
    "name": "Panier",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "label": "Après un ajout au panier",
        "options": [
          { "value": "drawer", "label": "Ouvrir le panier coulissant" },
          { "value": "page", "label": "Aller à la page panier" }
        ],
        "default": "drawer"
      },
      {
        "type": "number",
        "id": "free_shipping_threshold",
        "label": "Seuil de livraison offerte (€)",
        "info": "Affiche une barre de progression dans le panier. 0 pour la masquer. Pensez à configurer le même seuil dans Paramètres > Expédition.",
        "default": 500
      }
    ]
  },
  {
    "name": "Réseaux sociaux",
    "settings": [
      { "type": "text", "id": "social_instagram", "label": "Instagram", "info": "https://instagram.com/…" },
      { "type": "text", "id": "social_facebook", "label": "Facebook", "info": "https://facebook.com/…" },
      { "type": "text", "id": "social_pinterest", "label": "Pinterest", "info": "https://pinterest.com/…" },
      { "type": "text", "id": "social_tiktok", "label": "TikTok", "info": "https://tiktok.com/@…" },
      { "type": "text", "id": "social_youtube", "label": "YouTube", "info": "https://youtube.com/…" }
    ]
  }
]
