<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{{ settings.brand_name | default: shop.name }}</title>
    {%- liquid
      assign heading_font = settings.type_heading_font
      assign body_font = settings.type_body_font
    -%}
    <style>
      {{ heading_font | font_face: font_display: 'swap' }}
      {{ body_font | font_face: font_display: 'swap' }}
      :root {
        --font-heading: {{ heading_font.family }}, {{ heading_font.fallback_families }};
        --font-heading-weight: {{ heading_font.weight }};
        --font-body: {{ body_font.family }}, {{ body_font.fallback_families }};
        --font-body-weight: {{ body_font.weight }};
        --color-bg: {{ settings.color_background }};
        --color-bg-alt: {{ settings.color_background_alt }};
        --color-sand: {{ settings.color_sand }};
        --color-matcha-soft: {{ settings.color_matcha_soft }};
        --color-blush: {{ settings.color_blush }};
        --color-text: {{ settings.color_text }};
        --color-text-soft: {{ settings.color_text_soft }};
        --color-accent: {{ settings.color_accent }};
        --color-accent-dark: {{ settings.color_accent_dark }};
        --color-dark: {{ settings.color_dark }};
        --color-on-dark: {{ settings.color_on_dark }};
        --color-border: {{ settings.color_text | color_modify: 'alpha', 0.14 }};
        --radius: {{ settings.radius }}px;
        --page-width: {{ settings.page_width }}px;
      }
    </style>
    {{ 'theme.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>
  <body class="template-password">
    <main id="MainContent">
      {{ content_for_layout }}
    </main>
  </body>
</html>
