{%- comment -%}
  Icônes SVG au trait (style Lucide), décoratives par défaut.
  Utilisation : {% render 'icon', name: 'truck' %}
{%- endcomment -%}
{%- case name -%}
  {%- when 'star' -%}
    <svg class="icon icon--star" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.5l2.9 6 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.2 1.3-6.6-4.9-4.6 6.6-.8z"/></svg>
  {%- when 'instagram' -%}
    <svg class="icon" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r=".5" fill="currentColor"/></svg>
  {%- when 'facebook' -%}
    <svg class="icon" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
  {%- when 'pinterest' -%}
    <svg class="icon" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M11 8.5c2.5-1 5 .3 5 2.8 0 2.7-2 4.2-3.8 3.6-.8-.3-1.2-1-1.2-1L9.5 20M10 13.5c-.6-1.8.2-4 1-5"/></svg>
  {%- when 'tiktok' -%}
    <svg class="icon" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3v11.5a3.5 3.5 0 1 1-3.5-3.5"/><path d="M14 3c.4 2.8 2.2 4.6 5 5"/></svg>
  {%- when 'youtube' -%}
    <svg class="icon" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="5" width="20" height="14" rx="4"/><path d="m10 9 5 3-5 3z"/></svg>
  {%- else -%}
    <svg class="icon icon--{{ name }}" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      {%- case name -%}
        {%- when 'menu' -%}<path d="M3 6h18M3 12h18M3 18h18"/>
        {%- when 'close' -%}<path d="M18 6 6 18M6 6l12 12"/>
        {%- when 'search' -%}<circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/>
        {%- when 'account' -%}<circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 3.6-7 8-7s8 3 8 7"/>
        {%- when 'cart' -%}<path d="M6 7h12l1 14H5z"/><path d="M9 10V6a3 3 0 0 1 6 0v4"/>
        {%- when 'chevron-down' -%}<path d="m6 9 6 6 6-6"/>
        {%- when 'chevron-left' -%}<path d="m15 18-6-6 6-6"/>
        {%- when 'chevron-right' -%}<path d="m9 18 6-6-6-6"/>
        {%- when 'arrow-right' -%}<path d="M5 12h14M13 6l6 6-6 6"/>
        {%- when 'plus' -%}<path d="M12 5v14M5 12h14"/>
        {%- when 'minus' -%}<path d="M5 12h14"/>
        {%- when 'check' -%}<path d="M20 6 9 17l-5-5"/>
        {%- when 'truck' -%}<path d="M2 6h12v10H2zM14 9h4l4 4v3h-8z"/><circle cx="6" cy="18" r="2"/><circle cx="18" cy="18" r="2"/>
        {%- when 'return' -%}<path d="M3 7v5h5"/><path d="M3.5 12A9 9 0 1 0 6 6.3L3 9"/>
        {%- when 'shield' -%}<path d="M12 3 4 6v6c0 5 3.5 8 8 9 4.5-1 8-4 8-9V6z"/><path d="m9 12 2 2 4-4"/>
        {%- when 'credit-card' -%}<rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20M6 15h4"/>
        {%- when 'lock' -%}<rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/>
        {%- when 'leaf' -%}<path d="M11 20A7 7 0 0 1 4 13c0-6 6-9 16-9 0 10-3 16-9 16z"/><path d="M4 20c4-6 8-9 12-11"/>
        {%- when 'ruler' -%}<path d="m3 17 14-14 4 4L7 21z"/><path d="m7 13 2 2M10 10l2 2M13 7l2 2"/>
        {%- when 'sofa' -%}<path d="M4 11V8a3 3 0 0 1 3-3h10a3 3 0 0 1 3 3v3"/><path d="M2 13a2 2 0 0 1 4 0v2h12v-2a2 2 0 0 1 4 0v5H2z"/><path d="M5 18v2M19 18v2"/>
        {%- when 'phone' -%}<path d="M5 3h4l2 5-2.5 1.5a11 11 0 0 0 6 6L16 13l5 2v4a2 2 0 0 1-2 2A17 17 0 0 1 3 5a2 2 0 0 1 2-2z"/>
        {%- when 'mail' -%}<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/>
        {%- when 'filter' -%}<path d="M4 6h10M18 6h2M4 12h4M12 12h8M4 18h12M20 18h0"/><circle cx="16" cy="6" r="2"/><circle cx="10" cy="12" r="2"/><circle cx="18" cy="18" r="2"/>
        {%- when 'calendar' -%}<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/>
        {%- when 'swatch' -%}<circle cx="8" cy="8" r="5"/><circle cx="16" cy="16" r="5"/>
        {%- when 'tools' -%}<path d="M14.7 6.3a4 4 0 0 0-5.4 5.4L3 18l3 3 6.3-6.3a4 4 0 0 0 5.4-5.4l-2.5 2.5-2.5-.5-.5-2.5z"/>
        {%- when 'heart' -%}<path d="M12 20s-8-4.6-8-10.5A4.5 4.5 0 0 1 12 7a4.5 4.5 0 0 1 8 2.5C20 15.4 12 20 12 20z"/>
        {%- else -%}<circle cx="12" cy="12" r="9"/>
      {%- endcase -%}
    </svg>
{%- endcase -%}
