{%- comment -%}
  Ligne du panier (page panier et tiroir panier).
  - item : ligne du panier
  - line : numéro de la ligne (forloop.index)
  - context : 'page' | 'drawer'
{%- endcomment -%}

<div class="cart-item" data-line="{{ line }}">
  <a href="{{ item.url }}" class="cart-item__media" tabindex="-1" aria-hidden="true">
    <div class="media media--square">
      {%- if item.image -%}
        {{ item.image | image_url: width: 300 | image_tag: loading: 'lazy', alt: item.title, widths: '150, 300' }}
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
    </div>
  </a>

  <div class="cart-item__details">
    <h3 class="cart-item__title">
      <a href="{{ item.url }}">{{ item.product.title | escape }}</a>
    </h3>

    {%- unless item.product.has_only_default_variant and item.properties == empty and item.selling_plan_allocation == nil -%}
      <p class="cart-item__options">
        {%- unless item.product.has_only_default_variant -%}
          {%- for option in item.options_with_values -%}
            {{ option.name }} : {{ option.value }}{% unless forloop.last %}<br>{% endunless %}
          {%- endfor -%}
        {%- endunless -%}
        {%- for property in item.properties -%}
          {%- assign first_char = property.first | slice: 0 -%}
          {%- if property.last != blank and first_char != '_' -%}
            <br>{{ property.first }} : {{ property.last }}
          {%- endif -%}
        {%- endfor -%}
        {%- if item.selling_plan_allocation -%}
          <br>{{ item.selling_plan_allocation.selling_plan.name }}
        {%- endif -%}
      </p>
    {%- endunless -%}

    <div class="cart-item__actions">
      <div class="quantity">
        <button
          class="quantity__button"
          type="button"
          data-cart-change
          data-line="{{ line }}"
          data-quantity="{{ item.quantity | minus: 1 }}"
          aria-label="{{ 'cart.decrease' | t: product: item.product.title | escape }}"
        >
          {%- render 'icon', name: 'minus' -%}
        </button>
        <input
          class="quantity__input"
          type="number"
          name="updates[]"
          value="{{ item.quantity }}"
          min="0"
          {% if context == 'page' %}form="CartForm"{% else %}form="CartDrawerForm"{% endif %}
          data-cart-quantity
          data-line="{{ line }}"
          aria-label="{{ 'cart.quantity_for' | t: product: item.product.title | escape }}"
        >
        <button
          class="quantity__button"
          type="button"
          data-cart-change
          data-line="{{ line }}"
          data-quantity="{{ item.quantity | plus: 1 }}"
          aria-label="{{ 'cart.increase' | t: product: item.product.title | escape }}"
        >
          {%- render 'icon', name: 'plus' -%}
        </button>
      </div>
      <a
        href="{{ routes.cart_change_url }}?line={{ line }}&amp;quantity=0"
        class="cart-item__remove"
        data-cart-change
        data-line="{{ line }}"
        data-quantity="0"
      >
        {{- 'cart.remove' | t -}}
      </a>
    </div>
  </div>

  <div class="cart-item__price">
    {%- if item.original_line_price != item.final_line_price -%}
      <s class="price__compare">{{ item.original_line_price | money }}</s><br>
      <span class="price__sale">{{ item.final_line_price | money }}</span>
    {%- else -%}
      {{ item.final_line_price | money }}
    {%- endif -%}
    {%- for discount in item.line_level_discount_allocations -%}
      <small class="unit-price">{{ discount.discount_application.title }}</small>
    {%- endfor -%}
  </div>
</div>
