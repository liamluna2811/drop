{%- comment -%}
  Barre de progression « livraison offerte ». Le seuil se règle dans
  Paramètres du thème > Panier (en euros, 0 pour masquer).
{%- endcomment -%}
{%- liquid
  assign threshold = settings.free_shipping_threshold | times: 100
  if threshold > 0
    assign remaining = threshold | minus: cart.total_price
    assign remaining_money = remaining | money
    assign progress = cart.total_price | times: 100 | divided_by: threshold
    if progress > 100
      assign progress = 100
    endif
  endif
-%}
{%- if threshold > 0 and cart.item_count > 0 -%}
  <div class="free-shipping">
    {%- if remaining > 0 -%}
      {{ 'cart.free_shipping_remaining_html' | t: amount: remaining_money }}
    {%- else -%}
      {{ 'cart.free_shipping_reached' | t }}
    {%- endif -%}
    <div class="free-shipping__bar" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ progress }}">
      <span style="width: {{ progress }}%"></span>
    </div>
  </div>
{%- endif -%}
