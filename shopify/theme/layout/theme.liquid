<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <script>document.documentElement.className+=" js";</script>
  {%- liquid
    # Fiches produit : titre et description Google propres à la boutique (champs bandeja.seo_title / bandeja.seo_description)
    assign seo_t = blank
    assign seo_d = page_description
    if template.name == 'product'
      if product.metafields.bandeja.seo_title != blank
        assign seo_t = product.metafields.bandeja.seo_title.value
      endif
      if product.metafields.bandeja.seo_description != blank
        assign seo_d = product.metafields.bandeja.seo_description.value
      endif
    endif
  -%}
  <title>{% if seo_t != blank %}{{ seo_t }}{% else %}{{ page_title }}{% unless page_title contains shop.name %} – {{ shop.name }}{% endunless %}{% endif %}</title>
  {% if seo_d != blank %}<meta name="description" content="{{ seo_d | escape }}">{% endif %}
  <link rel="canonical" href="{{ canonical_url }}">
  {% render 'theme-head' %}
  {{ content_for_header }}
  <script>
    window.theme = {
      currency: {{ cart.currency.iso_code | json }},
      locale: {{ request.locale.iso_code | json }},
      moneyFormat: {{ shop.money_format | json }},
      collectionUrl: {{ routes.all_products_collection_url | json }},
      freeShipping: {{ settings.free_shipping_threshold | default: 60 | times: 100 }},
      country: {{ localization.country.iso_code | json }},
      sellTo: [{% for c in localization.available_countries %}{{ c.iso_code | json }}{% unless forloop.last %},{% endunless %}{% endfor %}]
    };
  </script>
</head>
<body>
  <div id="google_translate_element" hidden></div>
  {% section 'header' %}
  <main id="top">
    {{ content_for_layout }}
  </main>
  {% section 'footer' %}
  {% render 'cart-drawer' %}
  {% render 'cookie-banner' %}
  <script src="{{ 'theme.js' | asset_url }}" defer></script>
  <script src="{{ 'cookies.js' | asset_url }}" defer></script>
</body>
</html>
