<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <script>document.documentElement.className+=" js";</script>
  <title>{{ page_title }}{% unless page_title contains shop.name %} – {{ shop.name }}{% endunless %}</title>
  {% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
  <link rel="canonical" href="{{ canonical_url }}">
  {% render 'theme-head' %}
  {{ content_for_header }}
  <script>
    window.theme = {
      currency: {{ cart.currency.iso_code | json }},
      locale: {{ request.locale.iso_code | json }},
      moneyFormat: {{ shop.money_format | json }},
      collectionUrl: {{ routes.all_products_collection_url | json }},
      freeShipping: {{ settings.free_shipping_threshold | default: 60 | times: 100 }}
    };
  </script>
</head>
<body>
  <div id="google_translate_element" hidden></div>
  {% section 'header' %}
  <main id="top">
    {{ content_for_layout }}
  </main>
  {% section 'footer' %}
  {% render 'cart-drawer' %}
  {% render 'cookie-banner' %}
  <script src="{{ 'theme.js' | asset_url }}" defer></script>
  <script src="{{ 'cookies.js' | asset_url }}" defer></script>
</body>
</html>
