{%- comment -%}
  Fiche produit : galerie (devant / dos, flèches, balayage sur mobile), couleurs et tailles en français,
  guide des tailles en fenêtre (page choisie dans les réglages, sinon la page « guide-des-tailles »),
  barre d'achat fixe sur mobile.
{%- endcomment -%}
{%- assign current = product.selected_or_first_available_variant -%}
{%- liquid
  # Tableau des tailles : le premier bloc dont le mot-clé figure dans le titre du produit
  assign guide_block = nil
  assign title_lc = product.title | downcase
  for block in section.blocks
    if block.type == 'size_table'
      assign kw = block.settings.match | downcase | strip
      if kw != blank and title_lc contains kw
        assign guide_block = block
        break
      endif
    endif
  endfor
  # Sinon, une page Shopify (réglage, ou /pages/guide-des-tailles)
  assign guide_page = section.settings.size_guide
  if guide_page == blank
    assign guide_page = pages['guide-des-tailles']
  endif
  if guide_page.content == blank
    assign guide_page = nil
  endif
  assign has_guide = false
  if guide_block or guide_page
    assign has_guide = true
  endif
-%}
{%- assign is_perso = false -%}
{%- for t in product.tags -%}
  {%- assign tl = t | downcase | strip -%}
  {%- if tl == 'personnalise' or tl == 'personnalisé' -%}{%- assign is_perso = true -%}{%- endif -%}
{%- endfor -%}
{%- for c in product.collections -%}
  {%- if c.handle == 'personnalisation' -%}{%- assign is_perso = true -%}{%- endif -%}
{%- endfor -%}
{%- comment -%} Aperçu en direct du nom et du numéro sur la photo : premier bloc dont le mot-clé figure dans le titre (mot-clé vide = tous) {%- endcomment -%}
{%- assign live = nil -%}
{%- if is_perso and section.settings.perso_fields -%}
  {%- for block in section.blocks -%}
    {%- if block.type == 'perso_preview' -%}
      {%- assign kw = block.settings.match | downcase | strip -%}
      {%- if kw == blank or title_lc contains kw -%}{%- assign live = block -%}{%- break -%}{%- endif -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}
{%- assign has_3d = false -%}
{%- if product.tags contains '3d-bouteille' -%}{%- assign has_3d = true -%}{%- endif -%}
<section class="section product" data-product-section>
  {%- assign color_option = nil -%}
{%- for option in product.options_with_values -%}
  {%- assign oname = option.name | downcase -%}
  {%- if oname == 'couleur' or oname == 'color' or oname == 'colour' -%}{%- assign color_option = option -%}{%- endif -%}
{%- endfor -%}
  <div class="gallery">
    <div class="gallery-main">
      {%- for media in product.media -%}
        {%- assign src = media.preview_image.src | downcase -%}
        {%- assign media_color = '' -%}
        {%- assign best = 0 -%}
        {%- if color_option -%}
          {%- for value in color_option.values -%}
            {%- assign slug = value | handleize -%}
            {%- assign p1 = '-' | append: slug | append: '-' -%}
            {%- assign p2 = '-' | append: slug | append: '.' -%}
            {%- if src contains p1 or src contains p2 -%}
              {%- if slug.size > best -%}{%- assign media_color = value -%}{%- assign best = slug.size -%}{%- endif -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
        <div class="slide{% if forloop.first %} on{% endif %}" data-media-id="{{ media.id }}" data-color="{{ media_color | escape }}">
          {%- if src contains '-back' -%}{%- assign slide_view = 'dos' -%}{%- elsif src contains '-front' -%}{%- assign slide_view = 'devant' -%}{%- else -%}{%- assign slide_view = '' -%}{%- endif -%}
          {%- capture slide_alt -%}{% render 'media-alt', media: media, product: product, color: media_color, view: slide_view %}{%- endcapture -%}
          {{ media | image_url: width: 1000 | image_tag: widths: '500, 750, 1000', sizes: '(min-width: 900px) 55vw, 100vw', alt: slide_alt, loading: 'eager' }}
        </div>
      {%- else -%}
        <div class="slide on">{{ 'product-1' | placeholder_svg_tag: 'placeholder' }}</div>
      {%- endfor -%}
      {%- if live -%}{% render 'perso-live', live: live %}{%- endif -%}
      {%- if product.media.size > 1 -%}
        <button type="button" class="gal-nav gal-prev" data-gal="-1" aria-label="Image précédente">{% render 'icon', name: 'chevron-left' %}</button>
        <button type="button" class="gal-nav gal-next" data-gal="1" aria-label="Image suivante">{% render 'icon', name: 'chevron-right' %}</button>
      {%- endif -%}
      {%- if has_3d -%}
        <div class="slide slide-3d" data-media-id="3d" data-color="">
          <div data-3d-canvas></div>
          <p class="viewer-hint" data-3d-hint>Glisse pour tourner · pince pour zoomer</p>
          <div class="viewer-tools">
            <button type="button" data-3d-cap aria-pressed="false">Bouchon</button>
            <button type="button" data-3d-reset>Recentrer</button>
          </div>
        </div>
      {%- endif -%}
    </div>
    {%- if product.media.size > 1 or has_3d -%}
      <div class="thumbs">
        {%- for media in product.media -%}
          {%- assign src = media.preview_image.src | downcase -%}
          {%- assign media_color = '' -%}
          {%- assign best = 0 -%}
          {%- if color_option -%}
            {%- for value in color_option.values -%}
              {%- assign slug = value | handleize -%}
              {%- assign p1 = '-' | append: slug | append: '-' -%}
              {%- assign p2 = '-' | append: slug | append: '.' -%}
              {%- if src contains p1 or src contains p2 -%}
                {%- if slug.size > best -%}{%- assign media_color = value -%}{%- assign best = slug.size -%}{%- endif -%}
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}
          {%- assign view_label = '' -%}
          {%- if src contains '-back' -%}{%- assign view_label = 'Dos' -%}{%- elsif src contains '-front' -%}{%- assign view_label = 'Devant' -%}{%- elsif src contains '-left' -%}{%- assign view_label = 'Côté' -%}{%- elsif src contains '-right' -%}{%- assign view_label = 'Côté' -%}{%- endif -%}
          <button type="button" class="thumb{% if forloop.first %} on{% endif %}" data-thumb="{{ media.id }}" data-color="{{ media_color | escape }}" aria-label="{% if view_label != blank %}{{ view_label }}{% else %}Image {{ forloop.index }}{% endif %}">
            {{ media | image_url: width: 160 | image_tag: alt: '' }}
          </button>
        {%- endfor -%}
        {%- if has_3d -%}
          <button type="button" class="thumb thumb-3d" data-thumb="3d" data-color="" aria-label="Modèle 3D">3D</button>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>

  <div class="product-info">
    {%- capture badge -%}{% render 'product-badge', product: product %}{%- endcapture -%}
    {%- if badge != blank -%}<p class="eyebrow">{{ badge }}</p>{%- endif -%}
    <div class="title-row">
      <h1>{{ product.title }}</h1>
      <button type="button" class="fav-btn fav-btn-lg" data-fav="{{ product.handle }}" aria-pressed="false" aria-label="Ajouter aux favoris">{% render 'icon', name: 'heart' %}</button>
    </div>
    <span hidden data-seen="{{ product.handle }}"></span>
    <p class="price big" id="productPrice">{{ current.price | money }}</p>
    {%- if section.settings.price_note != blank -%}<p class="price-note">{{ section.settings.price_note }}</p>{%- endif -%}
    {%- if section.settings.delivery_note != blank -%}<p class="price-note delivery-note">{{ section.settings.delivery_note }}</p>{%- endif -%}

    {%- form 'product', product, id: 'product-form', class: 'product-form' -%}
      <input type="hidden" name="id" id="variantId" value="{{ current.id }}">
      {%- unless product.has_only_default_variant -%}
        {%- for option in product.options_with_values -%}
          {%- assign oname = option.name | downcase -%}
          {%- assign is_color = false -%}
          {%- assign is_size = false -%}
          {%- assign opt_label = option.name -%}
          {%- if oname == 'couleur' or oname == 'color' or oname == 'colour' -%}{%- assign is_color = true -%}{%- assign opt_label = 'Couleur' -%}{%- endif -%}
          {%- if oname == 'taille' or oname == 'size' -%}{%- assign is_size = true -%}{%- assign opt_label = 'Taille' -%}{%- endif -%}
          {%- capture selected_label -%}{% if is_color %}{% render 'color-label', name: option.selected_value %}{% else %}{{ option.selected_value }}{% endif %}{%- endcapture -%}
          <fieldset class="opt">
            <legend class="opt-legend">
              <span>{{ opt_label }} : <span data-selected-name="{{ forloop.index0 }}">{{ selected_label | strip }}</span></span>
              {%- if is_size and has_guide -%}
                <button type="button" class="guide-link" data-guide-open aria-haspopup="dialog">{% render 'icon', name: 'ruler' %}Guide des tailles</button>
              {%- endif -%}
            </legend>
            <div class="opt-values">
              {%- for value in option.values -%}
                {%- capture value_label -%}{% if is_color %}{% render 'color-label', name: value %}{% else %}{{ value }}{% endif %}{%- endcapture -%}
                {%- assign value_label = value_label | strip -%}
                <input type="radio" class="visually-hidden" id="opt-{{ forloop.parentloop.index0 }}-{{ forloop.index0 }}" name="options[{{ option.name | escape }}]" value="{{ value | escape }}" data-label="{{ value_label | escape }}" data-index="{{ forloop.parentloop.index0 }}"{% if is_color %} data-color-option{% endif %}{% if option.selected_value == value %} checked{% endif %}>
                {%- if is_color -%}
                  <label class="sw big" for="opt-{{ forloop.parentloop.index0 }}-{{ forloop.index0 }}" title="{{ value_label | escape }}" style="background:#cccccc;background:{% render 'color-hex', name: value %}"><span class="visually-hidden">{{ value_label }}</span></label>
                {%- else -%}
                  <label class="size" for="opt-{{ forloop.parentloop.index0 }}-{{ forloop.index0 }}">{{ value }}</label>
                {%- endif -%}
              {%- endfor -%}
            </div>
          </fieldset>
        {%- endfor -%}
      {%- endunless -%}
      {%- comment -%} Blocs d'applications (ex. outil de personnalisation) : dans le formulaire, pour que les choix du client partent avec l'article {%- endcomment -%}
      {%- for block in section.blocks -%}
        {%- if block.type == '@app' -%}<div class="app-block">{% render block %}</div>{%- endif -%}
      {%- endfor -%}
      {%- if is_perso and section.settings.perso_fields -%}
        {%- assign perso_max = section.settings.perso_name_max | default: 10 -%}
        <fieldset class="perso-fields" data-perso>
          <legend>{{ section.settings.perso_title }}</legend>
          <div class="perso-row">
            <div class="field">
              <label for="perso-nom">{{ section.settings.perso_name_label }}</label>
              <input id="perso-nom" name="properties[Nom]" type="text" required maxlength="{{ perso_max }}" autocomplete="off" spellcheck="false" pattern="[A-Za-zÀ-ÖØ-öø-ÿ][A-Za-zÀ-ÖØ-öø-ÿ'’ .\-]*" title="Lettres, espaces, tirets et apostrophes uniquement" aria-describedby="perso-nom-aide" data-perso-nom>
              <small class="fine" id="perso-nom-aide">{{ perso_max }} caractères maximum, écrit exactement comme tu veux le voir imprimé.</small>
            </div>
            <div class="field">
              <label for="perso-num">{{ section.settings.perso_number_label }}</label>
              <input id="perso-num" name="properties[Numéro]" type="text" required inputmode="numeric" maxlength="2" pattern="[0-9]{1,2}" title="Un nombre de 0 à 99" autocomplete="off" aria-describedby="perso-num-aide" data-perso-num>
              <small class="fine" id="perso-num-aide">De 0 à 99.</small>
            </div>
          </div>
          {%- if live -%}<div class="perso-mini" data-perso-mini aria-hidden="true"></div>{%- endif -%}
          {%- if live and section.settings.perso_preview_note != blank -%}<p class="fine perso-disclaimer">{{ section.settings.perso_preview_note }}</p>{%- endif -%}
          <p class="perso-preview" aria-live="polite">Sera imprimé : <strong data-perso-preview>…</strong></p>
          <label class="perso-check">
            <input type="checkbox" required>
            <span>J'ai vérifié l'orthographe du nom et le numéro.</span>
          </label>
        </fieldset>
      {%- endif -%}
      {%- if is_perso and section.settings.perso_note != blank -%}
        <div class="perso-note" role="note">{{ section.settings.perso_note }}</div>
      {%- endif -%}
      <div class="buy-row">
        <label class="qty-field"><span class="visually-hidden">Quantité</span>
          <input type="number" name="quantity" id="quantity" value="1" min="1" inputmode="numeric">
        </label>
        <button type="submit" class="btn full" id="addToCart"{% unless current.available %} disabled{% endunless %}>{% if current.available %}Ajouter au panier{% else %}Épuisé{% endif %}</button>
      </div>
      <p class="form-error" id="formError" role="alert" hidden></p>
    {%- endform -%}

    <ul class="perks">
      {%- for i in (1..3) -%}
        {%- assign k = 'perk_' | append: i -%}
        {%- if section.settings[k] != blank -%}<li>{{ section.settings[k] }}</li>{%- endif -%}
      {%- endfor -%}
    </ul>
    {%- comment -%} Description propre à la boutique (champ bandeja.description), sinon la description du produit {%- endcomment -%}
    {%- assign desc = product.metafields.bandeja.description.value | default: product.description -%}
    <div class="product-desc rte">{{ desc }}</div>
  </div>

  {%- if has_guide -%}
    <dialog class="guide" data-guide aria-labelledby="GuideTitle">
      <div class="guide-head">
        <h2 id="GuideTitle">{% if guide_block %}Guide des tailles{% else %}{{ guide_page.title }}{% endif %}</h2>
        <button type="button" class="guide-close" data-guide-close aria-label="Fermer">{% render 'icon', name: 'close' %}</button>
      </div>
      {%- if guide_block -%}
        {%- assign cols = guide_block.settings.columns | split: '|' -%}
        {%- assign rows = guide_block.settings.rows | newline_to_br | split: '<br />' -%}
        <div class="guide-body" {{ guide_block.shopify_attributes }}>
          {%- if guide_block.settings.title != blank -%}<p class="guide-sub">{{ guide_block.settings.title }}</p>{%- endif -%}
          <div class="guide-table">
            <table>
              <thead><tr>{%- for c in cols -%}<th scope="col">{{ c | strip }}</th>{%- endfor -%}</tr></thead>
              <tbody>
                {%- for r in rows -%}
                  {%- assign cells = r | strip | split: '|' -%}
                  {%- if cells.size > 0 -%}
                    <tr data-size="{{ cells[0] | strip | escape }}">{%- for c in cells -%}{%- if forloop.first -%}<th scope="row">{{ c | strip }}</th>{%- else -%}<td>{{ c | strip }}</td>{%- endif -%}{%- endfor -%}</tr>
                  {%- endif -%}
                {%- endfor -%}
              </tbody>
            </table>
          </div>
          {%- if guide_block.settings.how != blank -%}<div class="guide-how rte"><h3>Comment mesurer</h3>{{ guide_block.settings.how }}</div>{%- endif -%}
          {%- if guide_block.settings.note != blank -%}<p class="guide-note">{{ guide_block.settings.note }}</p>{%- endif -%}
        </div>
      {%- else -%}
        <div class="guide-body rte">{{ guide_page.content }}</div>
      {%- endif -%}
    </dialog>
  {%- endif -%}

  {%- if section.settings.sticky_atc -%}
    <div class="sticky-atc" data-sticky-atc aria-hidden="true">
      <div class="sticky-atc-info">
        <span class="sticky-atc-title">{{ product.title }}</span>
        <span class="sticky-atc-meta"><span data-sticky-variant></span><span data-sticky-price>{{ current.price | money }}</span></span>
      </div>
      <button type="button" class="btn" data-sticky-add tabindex="-1"{% unless current.available %} disabled{% endunless %}>{% if current.available %}Ajouter{% else %}Épuisé{% endif %}</button>
    </div>
  {%- endif -%}
  {%- if has_3d -%}
    <script>window.theme = window.theme || {}; window.theme.bottle = { module: {{ 'bottle-3d.js' | asset_url | json }}, texture: {{ 'bottle-body.jpg' | asset_url | json }} };</script>
  {%- endif -%}
  <script type="application/json" id="product-json">{{ product.variants | json }}</script>
</section>
{% schema %}
{
  "name": "Page produit",
  "settings": [
    { "type": "page", "id": "size_guide", "label": "Page du guide (si aucun tableau ne correspond)", "info": "Les blocs « Tableau des tailles » passent en premier. Sinon cette page, ou /pages/guide-des-tailles." },
    { "type": "checkbox", "id": "sticky_atc", "label": "Barre « Ajouter au panier » fixe sur mobile", "default": true },
    { "type": "header", "content": "Avantages sous le bouton" },
    { "type": "text", "id": "price_note", "label": "Ligne sous le prix", "default": "Des frais de livraison peuvent s'appliquer, calculés au paiement." },
    { "type": "text", "id": "delivery_note", "label": "Délais sous le prix", "default": "Fabriqué à la demande, livré en France en 1 à 2 semaines environ.", "info": "Estimation Printful pour la France (commande test du 2 octobre 2026 : livraison estimée en 6 à 8 jours ouvrés). Délais officiels Europe : fabrication 2 à 5 jours ouvrés, puis livraison 5 à 20 jours ouvrés." },
    { "type": "text", "id": "perk_1", "label": "Avantage 1", "default": "−10 % sur ta commande dès 60 € d'achat" },
    { "type": "text", "id": "perk_2", "label": "Avantage 2", "default": "Paiement 100 % sécurisé" },
    { "type": "text", "id": "perk_3", "label": "Avantage 3", "default": "Fabriqué à la demande, après ta commande" },
    { "type": "header", "content": "Produits personnalisés" },
    { "type": "checkbox", "id": "perso_fields", "label": "Champs « Nom » et « Numéro » à remplir", "default": true, "info": "Sur les mêmes produits. Le nom et le numéro arrivent dans la commande Shopify (et dans le panier) : à recopier dans la commande Printful « Requires personalization »." },
    { "type": "text", "id": "perso_title", "label": "Titre des champs", "default": "Personnalise ton t-shirt" },
    { "type": "text", "id": "perso_name_label", "label": "Libellé du nom", "default": "Nom ou prénom" },
    { "type": "text", "id": "perso_preview_note", "label": "Mention sous l'aperçu sur la photo", "default": "Ceci est un simple aperçu, pas l'impression réelle : la police, la taille et la position peuvent légèrement varier sur ton t-shirt.", "info": "Affichée seulement sur les produits qui ont un bloc « Aperçu nom sur photo »." },
    { "type": "range", "id": "perso_name_max", "label": "Nombre de caractères maximum du nom", "min": 4, "max": 16, "step": 1, "default": 10 },
    { "type": "text", "id": "perso_number_label", "label": "Libellé du numéro", "default": "Numéro" },
    { "type": "richtext", "id": "perso_note", "label": "Avertissement affiché au-dessus du bouton", "info": "Affiché uniquement sur les produits de la collection « Personnalisation » (ou portant le tag « personnalise »). Obligatoire : le client doit savoir avant de commander qu'il n'a pas de droit de rétractation.", "default": "<p><strong>Produit personnalisé :</strong> fabriqué selon tes choix, il n'est ni repris ni échangé (pas de droit de rétractation, article L221-28, 3° du Code de la consommation), sauf défaut. Vérifie l'orthographe, le contenu et l'aperçu avant de commander.</p>" }
  ],
  "blocks": [
    { "type": "@app" },
    {
      "type": "perso_preview",
      "name": "Aperçu nom sur photo",
      "settings": [
        { "type": "paragraph", "content": "Affiche le nom et le numéro tapés par le client sur la photo du produit, en direct. Produits personnalisés uniquement. Utilise des photos Printful générées sans texte (décor seul)." },
        { "type": "text", "id": "match", "label": "Mot-clé dans le titre du produit", "info": "Ex. « Signature ». Vide : tous les produits personnalisés." },
        { "type": "select", "id": "view", "label": "Photo utilisée", "options": [{ "value": "front", "label": "Devant" }, { "value": "back", "label": "Dos" }, { "value": "front-and-back", "label": "Devant et dos (2 t-shirts)" }], "default": "front" },
        { "type": "range", "id": "nth", "label": "Photo n° (pour cette vue)", "info": "Si Printful a créé plusieurs photos de cette vue par couleur.", "min": 1, "max": 4, "step": 1, "default": 1 },
        { "type": "text", "id": "note", "label": "Mention sur la photo", "default": "Aperçu indicatif" },
        { "type": "checkbox", "id": "mask", "label": "Cacher le texte d'exemple de la photo", "default": true, "info": "Si la photo Printful montre déjà un texte d'exemple : il est recouvert de la couleur du t-shirt dès que le client écrit." },
        { "type": "text", "id": "photo_name_text", "label": "Nom d'exemple visible sur la photo", "default": "NAME" },
        { "type": "text", "id": "photo_num_text", "label": "Numéro d'exemple visible sur la photo", "default": "12" },
        { "type": "header", "content": "Nom" },
        { "type": "select", "id": "name_font", "label": "Police", "options": [{ "value": "manuscrite", "label": "Manuscrite (Pacifico)" }, { "value": "baton", "label": "Bâton épais (Archivo Black)" }, { "value": "classique", "label": "Capitales classiques (Cinzel)" }, { "value": "italique", "label": "Italique (Fraunces)" }, { "value": "montserrat", "label": "Bâton gras (Montserrat)" }, { "value": "montserrat-fin", "label": "Bâton demi-gras (Montserrat)" }], "default": "manuscrite" },
        { "type": "text", "id": "name_ph", "label": "Texte d'exemple (champ vide)", "default": "Ton prénom" },
        { "type": "checkbox", "id": "name_upper", "label": "Majuscules", "default": false },
        { "type": "number", "id": "name_x", "label": "Position horizontale (%)", "default": 50, "info": "De 0 à 100, décimales acceptées (ex. 35.4)." },
        { "type": "number", "id": "name_y", "label": "Position verticale (%)", "default": 30, "info": "De 0 à 100, décimales acceptées (ex. 35.4)." },
        { "type": "range", "id": "name_size", "label": "Taille (% de la largeur de la photo)", "min": 1, "max": 20, "step": 0.2, "default": 6 },
        { "type": "range", "id": "name_ls", "label": "Espacement des lettres", "min": 0, "max": 40, "step": 1, "default": 0 },
        { "type": "range", "id": "name_rot", "label": "Rotation (degrés)", "min": -15, "max": 15, "step": 0.5, "default": 0 },
        { "type": "header", "content": "Numéro" },
        { "type": "select", "id": "num_font", "label": "Police", "options": [{ "value": "manuscrite", "label": "Manuscrite (Pacifico)" }, { "value": "baton", "label": "Bâton épais (Archivo Black)" }, { "value": "classique", "label": "Capitales classiques (Cinzel)" }, { "value": "italique", "label": "Italique (Fraunces)" }, { "value": "montserrat", "label": "Bâton gras (Montserrat)" }, { "value": "montserrat-fin", "label": "Bâton demi-gras (Montserrat)" }], "default": "italique" },
        { "type": "text", "id": "num_ph", "label": "Texte d'exemple (champ vide)", "default": "10" },
        { "type": "checkbox", "id": "num_outline", "label": "Numéro en contour (sans remplissage)", "default": false },
