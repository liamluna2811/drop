{%- comment -%}
  Fiche produit : galerie (devant / dos, flèches, balayage sur mobile), couleurs et tailles en français,
  guide des tailles en fenêtre (page choisie dans les réglages, sinon la page « guide-des-tailles »),
  barre d'achat fixe sur mobile.
{%- endcomment -%}
{%- assign current = product.selected_or_first_available_variant -%}
{%- liquid
  # Tableau des tailles : le premier bloc dont le mot-clé figure dans le titre du produit
  assign guide_block = nil
  assign title_lc = product.title | downcase
  for block in section.blocks
    if block.type == 'size_table'
      assign kw = block.settings.match | downcase | strip
      if kw != blank and title_lc contains kw
        assign guide_block = block
        break
      endif
    endif
  endfor
  # Sinon, une page Shopify (réglage, ou /pages/guide-des-tailles)
  assign guide_page = section.settings.size_guide
  if guide_page == blank
    assign guide_page = pages['guide-des-tailles']
  endif
  if guide_page.content == blank
    assign guide_page = nil
  endif
  assign has_guide = false
  if guide_block or guide_page
    assign has_guide = true
  endif
-%}
{%- assign has_3d = false -%}
{%- if product.tags contains '3d-bouteille' -%}{%- assign has_3d = true -%}{%- endif -%}
<section class="section product" data-product-section>
  {%- assign color_option = nil -%}
{%- for option in product.options_with_values -%}
  {%- assign oname = option.name | downcase -%}
  {%- if oname == 'couleur' or oname == 'color' or oname == 'colour' -%}{%- assign color_option = option -%}{%- endif -%}
{%- endfor -%}
  <div class="gallery">
    <div class="gallery-main">
      {%- for media in product.media -%}
        {%- assign src = media.preview_image.src | downcase -%}
        {%- assign media_color = '' -%}
        {%- assign best = 0 -%}
        {%- if color_option -%}
          {%- for value in color_option.values -%}
            {%- assign slug = value | handleize -%}
            {%- assign p1 = '-' | append: slug | append: '-' -%}
            {%- assign p2 = '-' | append: slug | append: '.' -%}
            {%- if src contains p1 or src contains p2 -%}
              {%- if slug.size > best -%}{%- assign media_color = value -%}{%- assign best = slug.size -%}{%- endif -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
        <div class="slide{% if forloop.first %} on{% endif %}" data-media-id="{{ media.id }}" data-color="{{ media_color | escape }}">
          {%- if src contains '-back' -%}{%- assign slide_view = 'dos' -%}{%- elsif src contains '-front' -%}{%- assign slide_view = 'devant' -%}{%- else -%}{%- assign slide_view = '' -%}{%- endif -%}
          {%- capture slide_alt -%}{% render 'media-alt', media: media, product: product, color: media_color, view: slide_view %}{%- endcapture -%}
          {{ media | image_url: width: 1000 | image_tag: widths: '500, 750, 1000', sizes: '(min-width: 900px) 55vw, 100vw', alt: slide_alt, loading: 'eager' }}
        </div>
      {%- else -%}
        <div class="slide on">{{ 'product-1' | placeholder_svg_tag: 'placeholder' }}</div>
      {%- endfor -%}
      {%- if product.media.size > 1 -%}
        <button type="button" class="gal-nav gal-prev" data-gal="-1" aria-label="Image précédente">{% render 'icon', name: 'chevron-left' %}</button>
        <button type="button" class="gal-nav gal-next" data-gal="1" aria-label="Image suivante">{% render 'icon', name: 'chevron-right' %}</button>
      {%- endif -%}
      {%- if has_3d -%}
        <div class="slide slide-3d" data-media-id="3d" data-color="">
          <div data-3d-canvas></div>
          <p class="viewer-hint" data-3d-hint>Glisse pour tourner · pince pour zoomer</p>
          <div class="viewer-tools">
            <button type="button" data-3d-cap aria-pressed="false">Bouchon</button>
            <button type="button" data-3d-reset>Recentrer</button>
          </div>
        </div>
      {%- endif -%}
    </div>
    {%- if product.media.size > 1 or has_3d -%}
      <div class="thumbs">
        {%- for media in product.media -%}
          {%- assign src = media.preview_image.src | downcase -%}
          {%- assign media_color = '' -%}
          {%- assign best = 0 -%}
          {%- if color_option -%}
            {%- for value in color_option.values -%}
              {%- assign slug = value | handleize -%}
              {%- assign p1 = '-' | append: slug | append: '-' -%}
              {%- assign p2 = '-' | append: slug | append: '.' -%}
              {%- if src contains p1 or src contains p2 -%}
                {%- if slug.size > best -%}{%- assign media_color = value -%}{%- assign best = slug.size -%}{%- endif -%}
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}
          {%- assign view_label = '' -%}
          {%- if src contains '-back' -%}{%- assign view_label = 'Dos' -%}{%- elsif src contains '-front' -%}{%- assign view_label = 'Devant' -%}{%- elsif src contains '-left' -%}{%- assign view_label = 'Côté' -%}{%- elsif src contains '-right' -%}{%- assign view_label = 'Côté' -%}{%- endif -%}
          <button type="button" class="thumb{% if forloop.first %} on{% endif %}" data-thumb="{{ media.id }}" data-color="{{ media_color | escape }}" aria-label="{% if view_label != blank %}{{ view_label }}{% else %}Image {{ forloop.index }}{% endif %}">
            {{ media | image_url: width: 160 | image_tag: alt: '' }}
            {%- if view_label != blank -%}<span class="thumb-label">{{ view_label }}</span>{%- endif -%}
          </button>
        {%- endfor -%}
        {%- if has_3d -%}
          <button type="button" class="thumb thumb-3d" data-thumb="3d" data-color="" aria-label="Modèle 3D">3D</button>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>

  <div class="product-info">
    {%- capture badge -%}{% render 'product-badge', product: product %}{%- endcapture -%}
    {%- if badge != blank -%}<p class="eyebrow">{{ badge }}</p>{%- endif -%}
    <h1>{{ product.title }}</h1>
    <p class="price big" id="productPrice">{{ current.price | money }}</p>

    {%- form 'product', product, id: 'product-form', class: 'product-form' -%}
      <input type="hidden" name="id" id="variantId" value="{{ current.id }}">
      {%- unless product.has_only_default_variant -%}
        {%- for option in product.options_with_values -%}
          {%- assign oname = option.name | downcase -%}
          {%- assign is_color = false -%}
          {%- assign is_size = false -%}
          {%- assign opt_label = option.name -%}
          {%- if oname == 'couleur' or oname == 'color' or oname == 'colour' -%}{%- assign is_color = true -%}{%- assign opt_label = 'Couleur' -%}{%- endif -%}
          {%- if oname == 'taille' or oname == 'size' -%}{%- assign is_size = true -%}{%- assign opt_label = 'Taille' -%}{%- endif -%}
          {%- capture selected_label -%}{% if is_color %}{% render 'color-label', name: option.selected_value %}{% else %}{{ option.selected_value }}{% endif %}{%- endcapture -%}
          <fieldset class="opt">
            <legend class="opt-legend">
              <span>{{ opt_label }} : <span data-selected-name="{{ forloop.index0 }}">{{ selected_label | strip }}</span></span>
              {%- if is_size and has_guide -%}
                <button type="button" class="guide-link" data-guide-open aria-haspopup="dialog">{% render 'icon', name: 'ruler' %}Guide des tailles</button>
              {%- endif -%}
            </legend>
            <div class="opt-values">
              {%- for value in option.values -%}
                {%- capture value_label -%}{% if is_color %}{% render 'color-label', name: value %}{% else %}{{ value }}{% endif %}{%- endcapture -%}
                {%- assign value_label = value_label | strip -%}
                <input type="radio" class="visually-hidden" id="opt-{{ forloop.parentloop.index0 }}-{{ forloop.index0 }}" name="options[{{ option.name | escape }}]" value="{{ value | escape }}" data-label="{{ value_label | escape }}" data-index="{{ forloop.parentloop.index0 }}"{% if is_color %} data-color-option{% endif %}{% if option.selected_value == value %} checked{% endif %}>
                {%- if is_color -%}
                  <label class="sw big" for="opt-{{ forloop.parentloop.index0 }}-{{ forloop.index0 }}" title="{{ value_label | escape }}" style="background:#cccccc;background:{% render 'color-hex', name: value %}"><span class="visually-hidden">{{ value_label }}</span></label>
                {%- else -%}
                  <label class="size" for="opt-{{ forloop.parentloop.index0 }}-{{ forloop.index0 }}">{{ value }}</label>
                {%- endif -%}
              {%- endfor -%}
            </div>
          </fieldset>
        {%- endfor -%}
      {%- endunless -%}
      <div class="buy-row">
        <label class="qty-field"><span class="visually-hidden">Quantité</span>
          <input type="number" name="quantity" id="quantity" value="1" min="1" inputmode="numeric">
        </label>
        <button type="submit" class="btn full" id="addToCart"{% unless current.available %} disabled{% endunless %}>{% if current.available %}Ajouter au panier{% else %}Épuisé{% endif %}</button>
      </div>
      <p class="form-error" id="formError" role="alert" hidden></p>
    {%- endform -%}

    <ul class="perks">
      {%- for i in (1..3) -%}
        {%- assign k = 'perk_' | append: i -%}
        {%- if section.settings[k] != blank -%}<li>{{ section.settings[k] }}</li>{%- endif -%}
      {%- endfor -%}
    </ul>
    <div class="product-desc rte">{{ product.description }}</div>
  </div>

  {%- if has_guide -%}
    <dialog class="guide" data-guide aria-labelledby="GuideTitle">
      <div class="guide-head">
        <h2 id="GuideTitle">{% if guide_block %}Guide des tailles{% else %}{{ guide_page.title }}{% endif %}</h2>
        <button type="button" class="guide-close" data-guide-close aria-label="Fermer">{% render 'icon', name: 'close' %}</button>
      </div>
      {%- if guide_block -%}
        {%- assign cols = guide_block.settings.columns | split: '|' -%}
        {%- assign rows = guide_block.settings.rows | newline_to_br | split: '<br />' -%}
        <div class="guide-body" {{ guide_block.shopify_attributes }}>
          {%- if guide_block.settings.title != blank -%}<p class="guide-sub">{{ guide_block.settings.title }}</p>{%- endif -%}
          <div class="guide-table">
            <table>
              <thead><tr>{%- for c in cols -%}<th scope="col">{{ c | strip }}</th>{%- endfor -%}</tr></thead>
              <tbody>
                {%- for r in rows -%}
                  {%- assign cells = r | strip | split: '|' -%}
                  {%- if cells.size > 0 -%}
                    <tr data-size="{{ cells[0] | strip | escape }}">{%- for c in cells -%}{%- if forloop.first -%}<th scope="row">{{ c | strip }}</th>{%- else -%}<td>{{ c | strip }}</td>{%- endif -%}{%- endfor -%}</tr>
                  {%- endif -%}
                {%- endfor -%}
              </tbody>
            </table>
          </div>
          {%- if guide_block.settings.how != blank -%}<div class="guide-how rte"><h3>Comment mesurer</h3>{{ guide_block.settings.how }}</div>{%- endif -%}
          {%- if guide_block.settings.note != blank -%}<p class="guide-note">{{ guide_block.settings.note }}</p>{%- endif -%}
        </div>
      {%- else -%}
        <div class="guide-body rte">{{ guide_page.content }}</div>
      {%- endif -%}
    </dialog>
  {%- endif -%}

  {%- if section.settings.sticky_atc -%}
    <div class="sticky-atc" data-sticky-atc aria-hidden="true">
      <div class="sticky-atc-info">
        <span class="sticky-atc-title">{{ product.title }}</span>
        <span class="sticky-atc-meta"><span data-sticky-variant></span><span data-sticky-price>{{ current.price | money }}</span></span>
      </div>
      <button type="button" class="btn" data-sticky-add tabindex="-1"{% unless current.available %} disabled{% endunless %}>{% if current.available %}Ajouter{% else %}Épuisé{% endif %}</button>
    </div>
  {%- endif -%}
  {%- if has_3d -%}
    <script>window.theme = window.theme || {}; window.theme.bottle = { module: {{ 'bottle-3d.js' | asset_url | json }}, texture: {{ 'bottle-body.jpg' | asset_url | json }} };</script>
  {%- endif -%}
  <script type="application/json" id="product-json">{{ product.variants | json }}</script>
</section>
{% schema %}
{
  "name": "Page produit",
  "settings": [
    { "type": "page", "id": "size_guide", "label": "Page du guide (si aucun tableau ne correspond)", "info": "Les blocs « Tableau des tailles » passent en premier. Sinon cette page, ou /pages/guide-des-tailles." },
    { "type": "checkbox", "id": "sticky_atc", "label": "Barre « Ajouter au panier » fixe sur mobile", "default": true },
    { "type": "header", "content": "Avantages sous le bouton" },
    { "type": "text", "id": "perk_1", "label": "Avantage 1", "default": "Livraison offerte dès 60 € en France et en Europe" },
    { "type": "text", "id": "perk_2", "label": "Avantage 2", "default": "Paiement 100 % sécurisé" },
    { "type": "text", "id": "perk_3", "label": "Avantage 3", "default": "Imprimé à la demande, après ta commande" }
  ],
  "blocks": [
    {
      "type": "size_table",
      "name": "Tableau des tailles",
      "settings": [
        { "type": "text", "id": "match", "label": "Mot-clé dans le titre du produit", "info": "Ex. « T-shirt de sport ». Majuscules indifférentes." },
        { "type": "text", "id": "title", "label": "Sous-titre", "default": "Mesures du produit, en centimètres" },
        { "type": "text", "id": "columns", "label": "Colonnes (séparées par |)", "default": "Taille | Longueur | Largeur" },
        { "type": "textarea", "id": "rows", "label": "Lignes (une taille par ligne, valeurs séparées par |)", "default": "S | 70 | 50" },
        { "type": "richtext", "id": "how", "label": "Comment mesurer" },
        { "type": "text", "id": "note", "label": "Note sous le tableau" }
      ]
    }
  ]
}
{% endschema %}
