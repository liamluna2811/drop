{%- comment -%} Page « boutique fermée » : logo, message, inscription aux nouvelles, accès par mot de passe. {%- endcomment -%}
<section class="pw">
  <div class="pw-card">
    <span class="logo notranslate" translate="no"><img class="logo-mark" src="{{ 'logo-mark.png' | asset_url }}" alt="" width="42" height="43">{{ section.settings.logo_1 }}<span>{{ section.settings.logo_2 }}</span></span>
    <h1>{{ section.settings.title }}</h1>
    {%- if section.settings.text != blank -%}<p class="pw-text">{{ section.settings.text }}</p>{%- endif -%}
    {%- if shop.password_message != blank -%}<p class="pw-text">{{ shop.password_message }}</p>{%- endif -%}

    {%- if section.settings.show_newsletter -%}
      {%- form 'customer', class: 'pw-form' -%}
        <input type="hidden" name="contact[tags]" value="password-page">
        {%- if form.posted_successfully? -%}
          <p class="pw-ok" role="status">Merci ! On te prévient dès l'ouverture.</p>
        {%- else -%}
          <label class="visually-hidden" for="PwEmail">Adresse email</label>
          <input id="PwEmail" type="email" name="contact[email]" required placeholder="ton@email.com" autocomplete="email">
          <button class="btn" type="submit">Me prévenir</button>
          {%- if form.errors -%}<p class="form-error" role="alert">{{ form.errors.messages | first | default: 'Adresse email invalide.' }}</p>{%- endif -%}
        {%- endif -%}
      {%- endform -%}
    {%- endif -%}

    {%- form 'storefront_password', class: 'pw-access' -%}
      <details{% if form.errors %} open{% endif %}>
        <summary>Accès avec mot de passe</summary>
        <div class="pw-form">
          <label class="visually-hidden" for="PwPass">Mot de passe</label>
          <input id="PwPass" type="password" name="password" required placeholder="Mot de passe" autocomplete="current-password">
          <button class="btn ghost" type="submit">Entrer</button>
          {%- if form.errors -%}<p class="form-error" role="alert">Mot de passe incorrect.</p>{%- endif -%}
        </div>
      </details>
    {%- endform -%}
  </div>
</section>
{% schema %}
{
  "name": "Mot de passe",
  "settings": [
    { "type": "text", "id": "logo_1", "label": "Logo (partie 1)", "default": "BANDEJA" },
    { "type": "text", "id": "logo_2", "label": "Logo (partie 2)", "default": "CLUB" },
    { "type": "text", "id": "title", "label": "Titre", "default": "On prépare le terrain." },
    { "type": "textarea", "id": "text", "label": "Texte", "default": "La boutique ouvre bientôt. Laisse ton email pour être prévenu dès l'ouverture." },
    { "type": "checkbox", "id": "show_newsletter", "label": "Inscription par email", "default": true }
  ]
}
{% endschema %}
