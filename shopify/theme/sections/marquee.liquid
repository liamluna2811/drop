{%- assign words = section.settings.words | split: ',' -%}
<div class="marquee scheme-{{ section.settings.scheme }}{% if section.settings.reverse %} marquee-rev{% endif %}" aria-hidden="true">
  <div class="marquee-track">
    {%- comment -%} Deux groupes identiques, chacun plus large que l'écran : le défilement boucle sans jamais laisser de vide {%- endcomment -%}
    {%- for g in (1..2) -%}
      <div class="marquee-group">{%- for i in (1..3) -%}{%- for w in words -%}<span>{{ w | strip }}</span>{%- endfor -%}{%- endfor -%}</div>
    {%- endfor -%}
  </div>
</div>
{% schema %}
{
  "name": "Bandeau défilant",
  "settings": [
    {"type": "select", "id": "scheme", "label": "Couleur de fond", "default": "alt", "options": [{"value": "none", "label": "Transparente (laisse voir l'animation de fond)"}, {"value": "bg", "label": "Crème"}, {"value": "alt", "label": "Beige"}, {"value": "surface", "label": "Blanc"}, {"value": "dark", "label": "Bleu marine"}]},
    { "type": "text", "id": "words", "label": "Mots (séparés par des virgules)", "default": "BANDEJA,VÍBORA,SMASH,CHIQUITA,GLOBO,REMATE" },
    { "type": "checkbox", "id": "reverse", "label": "Défiler dans l'autre sens", "default": false }
  ],
  "presets": [{ "name": "Bandeau défilant" }]
}
{% endschema %}
