<section class="section split" id="histoire">
  <div class="split-visual">
    <div class="split-shirt">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', alt: section.settings.image.alt }}
      {%- elsif collections['textiles'].products.first.featured_media -%}
        {%- assign story_product = collections['textiles'].products.first -%}
        {{ story_product.featured_media | image_url: width: 800 | image_tag: loading: 'lazy', alt: story_product.title }}
      {%- endif -%}
    </div>
  </div>
  <div class="split-text">
    <p class="eyebrow">{{ section.settings.eyebrow }}</p>
    <h2>{{ section.settings.title }}</h2>
    {{ section.settings.text }}
    <a href="{{ section.settings.button_url | default: routes.all_products_collection_url }}" class="btn">{{ section.settings.button_label }}</a>
  </div>
</section>
{% schema %}
{
  "name": "Notre histoire",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "Notre histoire" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Le padel, sur toi." },
    { "type": "richtext", "id": "text", "label": "Texte", "default": "<p>Bandeja Club propose des t-shirts, des brassières et des accessoires pour les joueurs de padel, avec des designs pensés autour du jeu : la bandeja, la vitre, le lob.</p><p>Chaque pièce est imprimée à la demande, après ta commande.</p>" },
    { "type": "text", "id": "button_label", "label": "Bouton", "default": "Voir les produits" },
    { "type": "url", "id": "button_url", "label": "Lien du bouton" },
    { "type": "image_picker", "id": "image", "label": "Image (par défaut : t-shirt Padel Club)" }
  ],
  "presets": [{ "name": "Notre histoire" }]
}
{% endschema %}
