<section class="section cart-page">
  <div class="section-head"><h1 class="h2">Ton panier</h1></div>
  {%- if cart.item_count == 0 -%}
    <p class="empty">Ton panier est vide.<br>Il est temps de s'équiper 🎾</p>
    <p class="center"><a class="btn" href="{{ routes.all_products_collection_url }}">Voir la collection</a></p>
  {%- else -%}
    <form action="{{ routes.cart_url }}" method="post">
      <div class="cart-lines">
        {%- for item in cart.items -%}
          <div class="line">
            <a class="thumb" href="{{ item.url }}">{%- if item.image -%}{{ item.image | image_url: width: 160 | image_tag: alt: item.product.title }}{%- endif -%}</a>
            <div>
              <h4><a href="{{ item.url }}">{{ item.product.title }}</a></h4>
              {%- unless item.product.has_only_default_variant -%}<small>{{ item.variant.title }}</small>{%- endunless -%}
              <div class="qty"><input type="number" class="qty-input" name="updates[]" value="{{ item.quantity }}" min="0" aria-label="Quantité {{ item.product.title | escape }}"></div>
            </div>
            <div class="right"><strong>{{ item.final_line_price | money }}</strong><br><a class="rm" href="{{ item.url_to_remove }}">Retirer</a></div>
          </div>
        {%- endfor -%}
      </div>
      <div class="cart-total">
        <div class="total"><span>Total</span><strong>{{ cart.total_price | money }}</strong></div>
        {%- unless customer -%}<p class="welcome-note"><strong>−10 % sur ta première commande</strong> : <a href="{{ routes.account_login_url }}">connecte-toi ou crée ton compte</a> avant de payer.</p>{%- endunless -%}
        <p class="ship">Taxes incluses. Frais de livraison calculés à l'étape suivante.</p>
        <div class="cart-actions">
          <button type="submit" name="update" class="btn ghost">Mettre à jour</button>
          <button type="submit" name="checkout" class="btn">Commander</button>
        </div>
      </div>
    </form>
  {%- endif -%}
</section>
{% schema %}
{ "name": "Panier" }
{% endschema %}
