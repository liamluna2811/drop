<div class="topbar">
  <span class="topbar-text">
    {%- comment -%} Client sans commande : offre de bienvenue (−15 %) ; client ayant déjà commandé : livraison offerte dès 60 € {%- endcomment -%}
    {%- if customer and customer.orders_count == 0 -%}
      {{ settings.announcement_first | default: settings.announcement_customer }}
    {%- elsif customer -%}
      {{ settings.announcement_customer }}
    {%- else -%}
      <a href="{{ routes.account_register_url }}">{{ settings.announcement }}</a>
    {%- endif -%}
  </span>
  <div class="lang-switch notranslate" translate="no" role="group" aria-label="Langue / Language">
    <button type="button" class="lang-btn" data-lang="fr" aria-pressed="true">FR</button>
    <span aria-hidden="true">/</span>
    <button type="button" class="lang-btn" data-lang="en" aria-pressed="false">EN</button>
  </div>
</div>
<header class="nav">
  <button type="button" class="menu-btn" data-menu-open aria-controls="MobileMenu" aria-expanded="false" aria-label="Ouvrir le menu">{% render 'icon', name: 'menu' %}</button>
  <a href="{{ routes.root_url }}" class="logo notranslate" translate="no"><img class="logo-mark" src="{{ 'logo-mark.png' | asset_url }}" alt="" width="42" height="43">{{ section.settings.logo_1 }}<span>{{ section.settings.logo_2 }}</span></a>
  <nav>
    {%- assign menu = linklists[section.settings.menu] -%}
    {%- if menu.links.size > 0 -%}
      {%- for link in menu.links -%}
        {%- if link.links.size > 0 -%}
          <div class="has-sub">
            <a href="{{ link.url }}" aria-haspopup="true">{{ link.title }} <span aria-hidden="true">▾</span></a>
            <div class="sub">
              {%- for child in link.links -%}<a href="{{ child.url }}">{{ child.title }}</a>{%- endfor -%}
            </div>
          </div>
        {%- else -%}
          <a href="{{ link.url }}">{{ link.title }}</a>
        {%- endif -%}
      {%- endfor -%}
    {%- else -%}
      <a href="{{ routes.all_products_collection_url }}">Collection</a>
    {%- endif -%}
  </nav>
  {%- assign fav_url = pages['favoris'].url | default: '/pages/favoris' -%}
  <div class="nav-actions">
    {%- if customer and customer.first_name != blank -%}<span class="hello">Salut, {{ customer.first_name | escape }}</span>{%- endif -%}
    <a class="fav-link" href="{{ fav_url }}" aria-label="Mes favoris">{% render 'icon', name: 'heart' %}<span class="fav-count" data-fav-count data-n="0">0</span></a>
    {%- comment -%} Compte : composant officiel Shopify (connexion par code e-mail, Google ou Shop, sans quitter le site).
      Tant que le composant n'est pas chargé (ou s'il ne se charge pas), un lien classique vers le compte s'affiche. {%- endcomment -%}
    <div class="acct" data-acct>
      {%- if shop.customer_accounts_enabled -%}
        <shopify-account menu="customer-account-main-menu"><span slot="signed-out-avatar" class="acct-icon">{% render 'icon', name: 'user' %}<span class="visually-hidden">Se connecter</span></span></shopify-account>
      {%- endif -%}
      <a class="acct-fallback" href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}" aria-label="{% if customer %}Mon compte{% else %}Se connecter{% endif %}">{% render 'icon', name: 'user' %}</a>
    </div>
    <a class="search-btn" href="{{ routes.search_url }}" data-search-open aria-label="Rechercher">{% render 'icon', name: 'search' %}</a>
    <button class="cart-btn" id="openCart" type="button" aria-label="Ouvrir le panier">
      {% render 'icon', name: 'cart' %}<span class="visually-hidden">Panier, articles :</span>
      <span class="cart-count" id="cartCount" data-n="{{ cart.item_count }}">{{ cart.item_count }}</span>
    </button>
  </div>
</header>
{%- comment -%} Recherche : barre qui s'ouvre sous l'en-tête (sans JavaScript, le lien mène à la page de recherche) {%- endcomment -%}
<dialog class="search-pop" data-search aria-label="Rechercher">
  <form class="search-form" action="{{ routes.search_url }}" method="get" role="search">
    <label class="visually-hidden" for="HeaderSearch">Rechercher</label>
    <input id="HeaderSearch" class="search-input" type="search" name="q" data-predictive placeholder="T-shirt, brassière, gourde…" autocomplete="off">
    <input type="hidden" name="options[prefix]" value="last">
    <button class="btn" type="submit">{% render 'icon', name: 'search' %}<span>Rechercher</span></button>
    <button class="search-close" type="button" data-search-close aria-label="Fermer la recherche">{% render 'icon', name: 'close' %}</button>
  </form>
  <div class="ps-box" data-ps-box aria-live="polite"></div>
</dialog>
{%- comment -%} Menu mobile : panneau latéral avec les mêmes liens que le menu principal {%- endcomment -%}
<dialog class="mnav" id="MobileMenu" aria-label="Menu" data-menu>
  <div class="mnav-head">
    <span class="logo notranslate" translate="no">{{ section.settings.logo_1 }}<span>{{ section.settings.logo_2 }}</span></span>
    <button type="button" class="mnav-close" data-menu-close aria-label="Fermer le menu">{% render 'icon', name: 'close' %}</button>
  </div>
  <nav class="mnav-links">
    {%- if menu.links.size > 0 -%}
      {%- for link in menu.links -%}
        {%- if link.links.size > 0 -%}
          <details class="mnav-group"{% if link.active or link.child_active %} open{% endif %}>
            <summary>{{ link.title }}</summary>
            <div class="mnav-sub">
              <a href="{{ link.url }}">Tout voir</a>
              {%- for child in link.links -%}<a href="{{ child.url }}"{% if child.active %} aria-current="page"{% endif %}>{{ child.title }}</a>{%- endfor -%}
            </div>
          </details>
        {%- else -%}
          <a class="mnav-link" href="{{ link.url }}"{% if link.active %} aria-current="page"{% endif %}>{{ link.title }}</a>
        {%- endif -%}
      {%- endfor -%}
    {%- else -%}
      <a class="mnav-link" href="{{ routes.all_products_collection_url }}">Collection</a>
    {%- endif -%}
  </nav>
  <div class="mnav-foot">
    {%- if customer and customer.first_name != blank -%}<p class="mnav-hello">Salut, {{ customer.first_name | escape }} !</p>{%- endif -%}
    <div class="mnav-quick">
      <a href="{{ fav_url }}">{% render 'icon', name: 'heart' %}Mes favoris</a>
      <a href="{{ pages['suivi'].url | default: '/pages/suivi' }}">{% render 'icon', name: 'package' %}Suivre ma commande</a>
    </div>
    {%- if customer -%}
      <a class="btn ghost full" href="{{ routes.account_url }}">Mon compte</a>
    {%- else -%}
      <a class="btn ghost full" href="{{ routes.account_login_url }}">Se connecter</a>
    {%- endif -%}
    {%- if section.settings.menu_note != blank -%}<p class="mnav-note">{{ section.settings.menu_note }}</p>{%- endif -%}
  </div>
</dialog>
{% schema %}
{
  "name": "En-tête",
  "settings": [
    { "type": "text", "id": "logo_1", "label": "Logo (partie 1)", "default": "BANDEJA" },
    { "type": "text", "id": "logo_2", "label": "Logo (partie 2, surlignée)", "default": "CLUB" },
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" },
    { "type": "text", "id": "menu_note", "label": "Phrase en bas du menu mobile", "default": "Livraison offerte dès 60 € d'achat" }
  ]
}
{% endschema %}
