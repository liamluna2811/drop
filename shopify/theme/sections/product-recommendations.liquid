{%- assign shown = 0 -%}
{%- capture cards -%}
  {%- for other in collections['all'].products -%}
    {%- if other.id != product.id and shown < section.settings.limit -%}
      {% render 'product-card', product: other %}
      {%- assign shown = shown | plus: 1 -%}
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}
{%- if shown > 0 -%}
<section class="section reco">
  <div class="section-head">
    <h2>{{ section.settings.title }}</h2>
  </div>
  <div class="grid reco-grid">
    {{ cards }}
  </div>
</section>
{%- endif -%}
{% schema %}
{
  "name": "Produits recommandés",
  "settings": [
    { "type": "text", "id": "title", "label": "Titre", "default": "Vous pourriez aussi aimer" },
    { "type": "range", "id": "limit", "min": 2, "max": 8, "step": 1, "label": "Nombre de produits", "default": 4 }
  ]
}
{% endschema %}
