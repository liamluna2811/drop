{%- comment -%}
  Produits associés : on propose d'abord des produits d'autres univers que celui du produit affiché
  (ex. pour un t-shirt Lifestyle : un t-shirt Sport, un accessoire…), en alternant les collections,
  puis on complète si besoin avec d'autres produits de la boutique.
{%- endcomment -%}
{%- liquid
  assign limit = section.settings.limit
  assign shown = 0
  assign picked = product.id | append: ','
  assign mine = product.collections | map: 'handle' | join: ','
  assign mine = ',' | append: mine | append: ','
-%}
{%- capture cards -%}
  {%- for round in (1..limit) -%}
    {%- assign skip = round | minus: 1 -%}
    {%- for c in collections -%}
      {%- if shown >= limit -%}{%- break -%}{%- endif -%}
      {%- if c.handle == 'frontpage' or c.handle == 'all' or c.all_products_count == 0 -%}{%- continue -%}{%- endif -%}
      {%- assign key = ',' | append: c.handle | append: ',' -%}
      {%- if mine contains key -%}{%- continue -%}{%- endif -%}
      {%- for other in c.products offset: skip limit: 1 -%}
        {%- assign tag = other.id | append: ',' -%}
        {%- assign others = other.collections | map: 'handle' -%}
        {%- assign same = false -%}
        {%- for h in others -%}{%- assign k = ',' | append: h | append: ',' -%}{%- if mine contains k -%}{%- assign same = true -%}{%- endif -%}{%- endfor -%}
        {%- unless picked contains tag or same -%}
          {% render 'product-card', product: other %}
          {%- assign picked = picked | append: tag -%}
          {%- assign shown = shown | plus: 1 -%}
        {%- endunless -%}
      {%- endfor -%}
    {%- endfor -%}
  {%- endfor -%}
  {%- if shown < limit -%}
    {%- for other in collections['all'].products -%}
      {%- if shown >= limit -%}{%- break -%}{%- endif -%}
      {%- assign tag = other.id | append: ',' -%}
      {%- unless picked contains tag -%}
        {% render 'product-card', product: other %}
        {%- assign picked = picked | append: tag -%}
        {%- assign shown = shown | plus: 1 -%}
      {%- endunless -%}
    {%- endfor -%}
  {%- endif -%}
{%- endcapture -%}
<section class="section reco"{% if shown == 0 %} hidden{% endif %}>
  <div class="section-head">
    <h2>{{ section.settings.title }}</h2>
  </div>
  <div class="grid reco-grid">
    {{ cards }}
  </div>
</section>
{% schema %}
{
  "name": "Produits recommandés",
  "settings": [
    { "type": "text", "id": "title", "label": "Titre", "default": "Vous pourriez aussi aimer" },
    { "type": "range", "id": "limit", "min": 2, "max": 8, "step": 1, "label": "Nombre de produits", "default": 4 },
    { "type": "paragraph", "content": "Affiche en priorité des produits des autres collections (univers) que celui du produit, pour varier les styles." }
  ]
}
{% endschema %}
