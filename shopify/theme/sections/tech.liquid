<section class="section tech" id="tech">
  <div class="section-head light">
    <p class="eyebrow">{{ section.settings.eyebrow }}</p>
    <h2>{{ section.settings.title }}</h2>
  </div>
  <div class="features">
    {%- for block in section.blocks -%}
      <article {{ block.shopify_attributes }}>
        <span class="ico">{{ block.settings.icon }}</span>
        <h3>{{ block.settings.title }}</h3>
        <p>{{ block.settings.text }}</p>
      </article>
    {%- endfor -%}
  </div>
</section>
{% schema %}
{
  "name": "Technologie",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "Technologie" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Caractéristiques" }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Atout",
      "settings": [
        { "type": "text", "id": "icon", "label": "Symbole", "default": "✓" },
        { "type": "text", "id": "title", "label": "Titre", "default": "Titre" },
        { "type": "textarea", "id": "text", "label": "Texte", "default": "Décris ici une caractéristique vérifiée du produit." }
      ]
    }
  ],
  "presets": [{ "name": "Technologie" }]
}
{% endschema %}
