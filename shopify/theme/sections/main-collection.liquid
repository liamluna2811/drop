<section class="section">
  <div class="section-head">
    <p class="eyebrow">Collection</p>
    <h1 class="h2">{{ collection.title }}</h1>
    {%- if collection.description != blank -%}<div class="desc">{{ collection.description }}</div>{%- endif -%}
  </div>
  {%- paginate collection.products by 12 -%}
    {%- if collection.products.size > 0 -%}
      <div class="grid">
        {%- for product in collection.products -%}{% render 'product-card', product: product %}{%- endfor -%}
      </div>
      {%- if paginate.pages > 1 -%}
        <nav class="pagination" aria-label="Pagination">
          {%- if paginate.previous -%}<a class="btn ghost" href="{{ paginate.previous.url }}">← Précédent</a>{%- endif -%}
          <span>{{ paginate.current_page }} / {{ paginate.pages }}</span>
          {%- if paginate.next -%}<a class="btn ghost" href="{{ paginate.next.url }}">Suivant →</a>{%- endif -%}
        </nav>
      {%- endif -%}
    {%- else -%}
      <p class="empty">Aucun produit dans cette collection pour le moment.</p>
    {%- endif -%}
  {%- endpaginate -%}
</section>
{% schema %}
{ "name": "Collection" }
{% endschema %}
