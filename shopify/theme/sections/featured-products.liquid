{%- assign coll = section.settings.collection | default: collections.all -%}
<section class="section" id="collection">
  <div class="section-head">
    <p class="eyebrow">{{ section.settings.eyebrow }}</p>
    <h2>{{ section.settings.title }}</h2>
  </div>
  {%- if coll.products.size > 0 -%}
    <div class="grid">
      {%- for product in coll.products limit: section.settings.limit -%}
        {% render 'product-card', product: product %}
      {%- endfor -%}
    </div>
  {%- else -%}
    <p class="empty">Ajoute des produits à cette collection pour les voir apparaître ici.</p>
  {%- endif -%}
</section>
{% schema %}
{
  "name": "Produits mis en avant",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "La collection" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Six designs, zéro compromis." },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "min": 3, "max": 12, "step": 1, "label": "Nombre de produits", "default": 6 }
  ],
  "presets": [{ "name": "Produits mis en avant" }]
}
{% endschema %}
