{%- comment -%}
  Questions fréquentes en accordéon (sans JavaScript, balises details).
  Une question sans réponse n'est pas affichée : pratique pour préparer une question à compléter plus tard.
{%- endcomment -%}
<section class="section faq" id="faq">
  <div class="section-head">
    {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h2>{{ section.settings.title }}</h2>
  </div>
  <div class="faq-list">
    {%- for block in section.blocks -%}
      {%- if block.settings.question != blank and block.settings.answer != blank -%}
        <details class="faq-item" {{ block.shopify_attributes }}>
          <summary>{{ block.settings.question }}</summary>
          <div class="faq-answer rte">{{ block.settings.answer }}</div>
        </details>
      {%- endif -%}
    {%- endfor -%}
  </div>
  {%- if section.settings.contact_text != blank -%}
    <p class="faq-contact">{{ section.settings.contact_text }} <a href="{{ pages['contact'].url | default: '/pages/contact' }}">Écris-nous</a></p>
  {%- endif -%}
</section>
{% schema %}
{
  "name": "Questions fréquentes",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "Aide" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Questions fréquentes" },
    { "type": "text", "id": "contact_text", "label": "Phrase avant le lien de contact", "default": "Tu ne trouves pas ta réponse ?" }
  ],
  "blocks": [
    {
      "type": "qa",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question" },
        { "type": "richtext", "id": "answer", "label": "Réponse", "info": "Laisse vide pour masquer la question." }
      ]
    }
  ],
  "presets": [{ "name": "Questions fréquentes" }]
}
{% endschema %}
