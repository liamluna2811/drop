<section class="section" id="avis">
  <div class="section-head">
    <p class="eyebrow">{{ section.settings.eyebrow }}</p>
    <h2>{{ section.settings.title }}</h2>
  </div>
  <div class="reviews">
    {%- for block in section.blocks -%}
      <blockquote {{ block.shopify_attributes }}>“{{ block.settings.quote }}”<cite>— {{ block.settings.author }}</cite></blockquote>
    {%- endfor -%}
  </div>
</section>
{% schema %}
{
  "name": "Avis clients",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "Avis" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Avis clients" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Avis",
      "settings": [
        { "type": "textarea", "id": "quote", "label": "Citation", "default": "Ajoute ici un avis réel d'un client." },
        { "type": "text", "id": "author", "label": "Auteur", "default": "Prénom du client" }
      ]
    }
  ],
  "presets": [{ "name": "Avis clients" }]
}
{% endschema %}
