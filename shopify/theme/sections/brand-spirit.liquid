<section class="section-d spirit scheme-{{ section.settings.scheme }}">
  <div class="wrap spirit-grid">
    <div class="spirit-text reveal">
      <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      <h2>{{ section.settings.title }}</h2>
      <div class="spirit-body">{{ section.settings.text }}</div>
      {%- if section.settings.button_label != blank -%}
        <a class="btn" href="{{ section.settings.button_url | default: routes.all_products_collection_url }}">{{ section.settings.button_label }}</a>
      {%- endif -%}
    </div>
    <div class="spirit-media reveal">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '450, 700, 900', sizes: '(min-width: 900px) 40vw, 90vw', alt: section.settings.image.alt | default: '' }}
      {%- else -%}
        <img class="spirit-logo" src="{{ 'logo-mark-light.png' | asset_url }}" alt="" width="300" height="307" loading="lazy">
      {%- endif -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Esprit de la marque",
  "settings": [
    { "type": "select", "id": "scheme", "label": "Couleur de fond", "default": "dark", "options": [{ "value": "none", "label": "Transparente (laisse voir l'animation de fond)" }, { "value": "bg", "label": "Crème" }, { "value": "alt", "label": "Beige" }, { "value": "surface", "label": "Blanc" }, { "value": "dark", "label": "Bleu marine" }] },
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "L'esprit Bandeja Club" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Entre joueurs, on se comprend." },
    { "type": "richtext", "id": "text", "label": "Texte", "default": "<p>Bandeja Club, ce sont des t-shirts et des accessoires pensés pour les joueurs et joueuses de padel. Des designs qui parlent du jeu, la bandeja, la vitre, le lob, avec un clin d'œil.</p><p>Chaque pièce est imprimée à la demande, après ta commande.</p>" },
    { "type": "text", "id": "button_label", "label": "Bouton", "default": "Découvrir la collection" },
    { "type": "url", "id": "button_url", "label": "Lien du bouton" },
    { "type": "image_picker", "id": "image", "label": "Image (par défaut : le logo)" }
  ],
  "presets": [{ "name": "Esprit de la marque" }]
}
{% endschema %}
