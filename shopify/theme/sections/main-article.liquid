{%- comment -%} Article de blog : titre, date, image, contenu, retour au blog. {%- endcomment -%}
<article class="section article">
  <a class="article-back" href="{{ blog.url }}">← {{ blog.title }}</a>
  <header class="article-head">
    <time class="post-date" datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ article.published_at | date: format: 'date' }}</time>
    <h1 class="h2">{{ article.title }}</h1>
    {%- if section.settings.show_author and article.author != blank -%}<p class="article-author">Par {{ article.author }}</p>{%- endif -%}
  </header>
  {%- if article.image -%}
    <div class="article-image">{{ article.image | image_url: width: 1600 | image_tag: widths: '600, 900, 1200, 1600', sizes: '(min-width: 1000px) 900px, 100vw', alt: article.image.alt | default: article.title }}</div>
  {%- endif -%}
  <div class="rte article-body">{{ article.content }}</div>
  {%- if article.tags.size > 0 -%}
    <p class="article-tags">{%- for tag in article.tags -%}<a href="{{ blog.url }}/tagged/{{ tag | handleize }}">{{ tag }}</a>{%- endfor -%}</p>
  {%- endif -%}
</article>
{% schema %}
{
  "name": "Article",
  "settings": [
    { "type": "checkbox", "id": "show_author", "label": "Afficher l'auteur", "default": false }
  ]
}
{% endschema %}
