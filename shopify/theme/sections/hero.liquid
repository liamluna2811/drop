<section class="hero">
  <div class="hero-text">
    <p class="eyebrow">{{ section.settings.eyebrow }}</p>
    <h1>{{ section.settings.title_1 }}<br>{{ section.settings.title_2 }}<br><em>{{ section.settings.title_highlight }}</em></h1>
    <p class="lead">{{ section.settings.lead }}</p>
    <div class="hero-cta">
      <a href="{{ section.settings.button_url | default: routes.all_products_collection_url }}" class="btn">{{ section.settings.button_label }}</a>
      <a href="#tech" class="btn ghost">{{ section.settings.button2_label }}</a>
    </div>
    <ul class="hero-stats">
      {%- for block in section.blocks -%}
        <li {{ block.shopify_attributes }}><strong>{{ block.settings.value }}</strong>{{ block.settings.label }}</li>
      {%- endfor -%}
    </ul>
  </div>
  <div class="hero-visual">
    <div class="ball" aria-hidden="true"></div>
    <div class="hero-shirt">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 900 | image_tag: loading: 'eager', widths: '450, 900', alt: section.settings.image.alt }}
      {%- else -%}
        <img src="{{ 'mockup-hero-2.png' | asset_url }}" alt="T-shirt Pas ce soir, j'ai padel" width="900" height="900">
      {%- endif -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Bannière d'accueil",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "Drop #03 — Saison 2026" },
    { "type": "text", "id": "title_1", "label": "Titre, ligne 1", "default": "Joue" },
    { "type": "text", "id": "title_2", "label": "Titre, ligne 2", "default": "comme" },
    { "type": "text", "id": "title_highlight", "label": "Titre, ligne surlignée", "default": "tu vis." },
    { "type": "textarea", "id": "lead", "label": "Texte", "default": "Des t-shirts de padel conçus sur le court : ultra-légers, respirants, et assez stylés pour l'afterwork." },
    { "type": "text", "id": "button_label", "label": "Bouton principal", "default": "Voir la collection" },
    { "type": "url", "id": "button_url", "label": "Lien du bouton principal" },
    { "type": "text", "id": "button2_label", "label": "Bouton secondaire", "default": "Pourquoi nous ?" },
    { "type": "image_picker", "id": "image", "label": "Image (par défaut : t-shirt Pas ce soir)" }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Chiffre clé",
      "settings": [
        { "type": "text", "id": "value", "label": "Valeur", "default": "4,9/5" },
        { "type": "text", "id": "label", "label": "Légende", "default": "2 300+ avis" }
      ]
    }
  ],
  "presets": [{ "name": "Bannière d'accueil" }]
}
{% endschema %}
