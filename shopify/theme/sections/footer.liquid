<footer class="footer">
  <a href="{{ routes.root_url }}" class="logo">{{ section.settings.logo_1 }}<span>{{ section.settings.logo_2 }}</span></a>
  <p>© {{ 'now' | date: '%Y' }} {{ shop.name }} · {{ section.settings.text }}</p>
</footer>
{% schema %}
{
  "name": "Pied de page",
  "settings": [
    { "type": "text", "id": "logo_1", "label": "Logo (partie 1)", "default": "BANDEJA" },
    { "type": "text", "id": "logo_2", "label": "Logo (partie 2)", "default": "CLUB" },
    { "type": "text", "id": "text", "label": "Texte", "default": "Paiement sécurisé · Livraison en France & Europe" }
  ]
}
{% endschema %}
