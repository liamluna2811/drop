<footer class="footer">
  <a href="{{ routes.root_url }}" class="logo"><img class="logo-mark" src="{{ 'logo-mark-light.png' | asset_url }}" alt="" width="42" height="43">{{ section.settings.logo_1 }}<span>{{ section.settings.logo_2 }}</span></a>
  <p>© {{ 'now' | date: '%Y' }} {{ shop.name }} · {{ section.settings.text }}</p>
  {%- assign help = linklists[section.settings.menu] -%}
  {%- if help.links.size > 0 -%}
    <nav class="legal-links help-links" aria-label="Aide">
      {%- for link in help.links -%}<a href="{{ link.url }}">{{ link.title }}</a>{%- endfor -%}
    </nav>
  {%- endif -%}
  <nav class="legal-links" aria-label="Informations légales">
    <a href="/pages/mentions-legales">Mentions légales</a>
    <a href="/pages/conditions-generales-de-vente">CGV</a>
    <a href="/pages/conditions-generales-d-utilisation">CGU</a>
    <a href="/pages/politique-de-confidentialite">Confidentialité</a>
    <a href="/pages/politique-de-cookies">Cookies</a>
    <a href="#gerer-cookies" data-cookie-open>Gérer mes cookies</a>
    <a href="/pages/retractation-et-retours">Retours et rétractation</a>
  </nav>
</footer>
{% schema %}
{
  "name": "Pied de page",
  "settings": [
    { "type": "text", "id": "logo_1", "label": "Logo (partie 1)", "default": "BANDEJA" },
    { "type": "text", "id": "logo_2", "label": "Logo (partie 2)", "default": "CLUB" },
    { "type": "text", "id": "text", "label": "Texte", "default": "Paiement sécurisé · Livraison en France & Europe" },
    { "type": "link_list", "id": "menu", "label": "Menu d'aide (suivi, questions…)", "default": "footer", "info": "Affiché au-dessus des liens légaux, qui restent fixes." }
  ]
}
{% endschema %}
