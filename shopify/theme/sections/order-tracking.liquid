{%- comment -%}
  Page « Suivre ma commande » : les étapes d'une commande imprimée à la demande, puis deux accès :
  - avec un compte : connexion, la liste des commandes et leur suivi ;
  - sans compte : le lien de l'e-mail de confirmation ou d'expédition (page de suivi Shopify).
  Le délai d'une étape ne s'affiche que s'il est rempli.
{%- endcomment -%}
<section class="section track">
  <div class="section-head">
    {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h1 class="h2">{{ section.settings.title }}</h1>
    {%- if section.settings.text != blank -%}<p class="desc">{{ section.settings.text }}</p>{%- endif -%}
  </div>

  <ol class="track-steps">
    {%- for block in section.blocks -%}
      <li class="track-step" {{ block.shopify_attributes }}>
        <span class="track-dot" aria-hidden="true">{{ forloop.index }}</span>
        <div>
          <h3>{{ block.settings.title }}</h3>
          {%- if block.settings.text != blank -%}<p>{{ block.settings.text }}</p>{%- endif -%}
          {%- if block.settings.delay != blank -%}<p class="track-delay">{{ block.settings.delay }}</p>{%- endif -%}
        </div>
      </li>
    {%- endfor -%}
  </ol>

  <div class="track-cards">
    <div class="track-card">
      <span class="track-ico">{% render 'icon', name: 'user' %}</span>
      <h2 class="h4">{{ section.settings.account_title }}</h2>
      <p>{{ section.settings.account_text }}</p>
      {%- if customer -%}
        <a class="btn" href="{{ routes.account_url }}">Voir mes commandes</a>
      {%- else -%}
        <a class="btn" href="{{ routes.account_login_url }}">Me connecter</a>
      {%- endif -%}
    </div>
    <div class="track-card">
      <span class="track-ico">{% render 'icon', name: 'package' %}</span>
      <h2 class="h4">{{ section.settings.guest_title }}</h2>
      <p>{{ section.settings.guest_text }}</p>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Suivi de commande",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "Ta commande" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Suivre ma commande" },
    { "type": "textarea", "id": "text", "label": "Texte sous le titre", "default": "Chaque pièce est imprimée à la demande, après ta commande. Voici les étapes jusqu'à chez toi." },
    { "type": "header", "content": "Avec un compte" },
    { "type": "text", "id": "account_title", "label": "Titre", "default": "Tu as un compte" },
    { "type": "textarea", "id": "account_text", "label": "Texte", "default": "Connecte-toi : toutes tes commandes et leur suivi t'attendent dans ton compte." },
    { "type": "header", "content": "Sans compte" },
    { "type": "text", "id": "guest_title", "label": "Titre", "default": "Tu as commandé sans compte" },
    { "type": "textarea", "id": "guest_text", "label": "Texte", "default": "Ouvre le lien de ton e-mail de confirmation ou d'expédition : il mène directement au suivi de ta commande, sans mot de passe." }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Étape",
      "settings": [
        { "type": "text", "id": "title", "label": "Titre" },
        { "type": "textarea", "id": "text", "label": "Texte" },
        { "type": "text", "id": "delay", "label": "Délai (facultatif)", "info": "Par exemple « 2 à 5 jours ouvrés ». Laisse vide pour ne rien afficher." }
      ]
    }
  ],
  "presets": [{ "name": "Suivi de commande" }]
}
{% endschema %}
