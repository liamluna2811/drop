{%- comment -%} Blog : liste des articles en cartes (image, date, titre, extrait). {%- endcomment -%}
<section class="section">
  <div class="section-head">
    {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h1 class="h2">{{ blog.title }}</h1>
  </div>
  {%- paginate blog.articles by 12 -%}
    {%- if blog.articles.size > 0 -%}
      <div class="post-grid">
        {%- for article in blog.articles -%}
          <article class="post-card">
            <a class="post-media" href="{{ article.url }}" tabindex="-1" aria-hidden="true">
              {%- if article.image -%}{{ article.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400, 600, 900', sizes: '(min-width: 900px) 31vw, (min-width: 600px) 48vw, 100vw', alt: '' }}{%- endif -%}
            </a>
            <div class="post-body">
              <time class="post-date" datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ article.published_at | date: format: 'date' }}</time>
              <h2 class="post-title"><a href="{{ article.url }}">{{ article.title }}</a></h2>
              <p class="post-excerpt">{{ article.excerpt_or_content | strip_html | truncatewords: 26 }}</p>
            </div>
          </article>
        {%- endfor -%}
      </div>
      {%- if paginate.pages > 1 -%}
        <nav class="pagination" aria-label="Pagination">
          {%- if paginate.previous -%}<a class="btn ghost" href="{{ paginate.previous.url }}">← Précédent</a>{%- endif -%}
          <span>{{ paginate.current_page }} / {{ paginate.pages }}</span>
          {%- if paginate.next -%}<a class="btn ghost" href="{{ paginate.next.url }}">Suivant →</a>{%- endif -%}
        </nav>
      {%- endif -%}
    {%- else -%}
      <p class="empty">Aucun article pour le moment.</p>
    {%- endif -%}
  {%- endpaginate -%}
</section>
{% schema %}
{
  "name": "Blog",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "Le journal" }
  ]
}
{% endschema %}
