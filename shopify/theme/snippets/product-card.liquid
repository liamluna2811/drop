{%- assign color_option = nil -%}
{%- for option in product.options_with_values -%}
  {%- assign oname = option.name | downcase -%}
  {%- if oname == 'couleur' or oname == 'color' or oname == 'colour' -%}{%- assign color_option = option -%}{%- endif -%}
{%- endfor -%}
<article class="card">
  <a class="card-img" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
    {%- if product.tags.size > 0 -%}<span class="tag">{{ product.tags.first }}</span>{%- endif -%}
    {%- if product.featured_media -%}
      {{ product.featured_media | image_url: width: 700 | image_tag: loading: 'lazy', widths: '350, 700', alt: product.featured_media.alt | default: product.title }}
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag: 'placeholder' }}
    {%- endif -%}
  </a>
  <div class="card-body">
    <div class="card-top">
      <h3><a href="{{ product.url }}">{{ product.title }}</a></h3>
      <span class="price">{{ product.price | money }}</span>
    </div>
    {%- if product.description != blank -%}<p class="desc">{{ product.description | strip_html | truncate: 110 }}</p>{%- endif -%}
    {%- if color_option -%}
      <div class="swatches">
        {%- for value in color_option.values -%}
          {%- assign v = product.variants | where: 'option1', value | first -%}
          <a class="sw" href="{{ product.url }}?variant={{ v.id }}" aria-label="{{ value | escape }}" title="{{ value | escape }}" style="background:#cccccc;background:{% render 'color-hex', name: value %}"></a>
        {%- endfor -%}
      </div>
    {%- endif -%}
    <a class="add" href="{{ product.url }}">Choisir ma taille</a>
  </div>
</article>
