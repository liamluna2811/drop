{%- comment -%} Renvoie la couleur CSS d'une valeur d'option couleur (français et anglais). Usage : {% render 'color-hex', name: value %} {%- endcomment -%}
{%- assign key = name | downcase | strip -%}
{%- case key -%}
  {%- when 'nuit', 'navy', 'navy blue', 'midnight navy' -%}#0b1b2b
  {%- when 'forêt', 'foret', 'forest green', 'forest', 'dark green' -%}#14532d
  {%- when 'noir', 'black', 'vintage black' -%}#141414
  {%- when 'blanc', 'white' -%}#ffffff
  {%- when 'sable', 'sand', 'natural', 'cream', 'beige', 'ivory' -%}#efe3c8
  {%- when 'ciel', 'sky blue', 'light blue', 'baby blue' -%}#bfe0ff
  {%- when 'carolina blue' -%}#7ba9d4
  {%- when 'lime', 'lime green', 'neon green' -%}#d4ff3a
  {%- when 'orange' -%}#f47521
  {%- when 'azalea' -%}#f29ab6
  {%- when 'light pink', 'rose clair', 'pastel pink', 'baby pink' -%}#f4c6d6
  {%- when 'pink', 'rose', 'hot pink' -%}#ec6f9f
  {%- when 'red', 'rouge' -%}#d62828
  {%- when 'maroon', 'burgundy', 'bordeaux' -%}#6d1a2b
  {%- when 'royal', 'royal blue', 'bleu roi', 'blue', 'bleu' -%}#1f4eb4
  {%- when 'true royal' -%}#2559b7
  {%- when 'green', 'vert', 'kelly green' -%}#1f9d55
  {%- when 'mint', 'menthe' -%}#a8ecd0
  {%- when 'yellow', 'jaune', 'gold', 'daisy' -%}#f6c927
  {%- when 'purple', 'violet', 'lilac', 'lilas' -%}#7b4bb7
  {%- when 'grey', 'gray', 'gris', 'heather grey', 'heather gray', 'sport grey', 'athletic heather' -%}#a7a9ac
  {%- when 'charcoal', 'dark heather', 'dark grey', 'anthracite' -%}#4a4d52
  {%- when 'brown', 'marron', 'chocolate' -%}#5b3a29
  {%- else -%}{{ key | remove: ' ' }}
{%- endcase -%}
