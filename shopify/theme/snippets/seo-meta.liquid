{%- comment -%}
  Balises lues par Google et par les réseaux sociaux :
  - Open Graph / Twitter : titre, description et image affichés quand un lien est partagé (WhatsApp, Instagram, Facebook…)
  - Données structurées (JSON-LD) : boutique sur l'accueil, produit (prix, disponibilité) sur les fiches produit
  Aucune note ni avis n'est déclaré : la boutique n'en a pas.
{%- endcomment -%}
{%- liquid
  assign og_title = page_title | default: shop.name
  assign og_type = 'website'
  if request.page_type == 'product'
    assign og_type = 'product'
  endif
  if page_image
    assign og_image = page_image | image_url: width: 1200
  else
    assign og_image = 'logo-mark.png' | asset_url
  endif
-%}
<meta property="og:site_name" content="{{ shop.name | escape }}">
<meta property="og:url" content="{{ canonical_url }}">
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:type" content="{{ og_type }}">
{%- if page_description %}
<meta property="og:description" content="{{ page_description | escape }}">
{%- endif %}
<meta property="og:image" content="https:{{ og_image | remove_first: 'https:' }}">
<meta property="og:locale" content="fr_FR">
{%- if request.page_type == 'product' %}
<meta property="product:price:amount" content="{{ product.price | divided_by: 100.0 }}">
<meta property="product:price:currency" content="{{ cart.currency.iso_code }}">
{%- endif %}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ og_title | escape }}">
{%- if page_description %}
<meta name="twitter:description" content="{{ page_description | escape }}">
{%- endif %}

{%- if request.page_type == 'index' %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "OnlineStore",
  "name": {{ shop.name | json }},
  "url": {{ shop.url | append: routes.root_url | json }},
  "logo": {{ 'logo-mark.png' | asset_url | prepend: 'https:' | json }},
  "email": {{ shop.email | json }}
}
</script>
{%- endif %}

{%- if request.page_type == 'product' %}
{%- assign seo_url = shop.url | append: product.url -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "ProductGroup",
  "name": {{ product.title | json }},
  "url": {{ seo_url | json }},
  "productGroupID": "{{ product.id }}",
  "description": {{ product.description | strip_html | strip_newlines | truncate: 500 | json }},
  "brand": { "@type": "Brand", "name": "Bandeja Club" },
  {%- if product.featured_media %}
  "image": {{ product.featured_media | image_url: width: 1200 | prepend: 'https:' | json }},
  {%- endif %}
  {%- unless product.has_only_default_variant %}
  "variesBy": [
    {%- for option in product.options -%}
      {%- assign o = option | downcase -%}
      {%- if o contains 'taille' or o contains 'size' -%}"https://schema.org/size"{%- elsif o contains 'couleur' or o contains 'color' -%}"https://schema.org/color"{%- else -%}{{ option | json }}{%- endif -%}
      {%- unless forloop.last %},{% endunless -%}
    {%- endfor -%}
  ],
  {%- endunless %}
  "hasVariant": [
    {%- for variant in product.variants limit: 100 %}
    {
      "@type": "Product",
      "name": {% if product.has_only_default_variant %}{{ product.title | json }}{% else %}{{ product.title | append: ' – ' | append: variant.title | json }}{% endif %},
      {%- if variant.sku != blank %}
      "sku": {{ variant.sku | json }},
      {%- endif %}
      {%- if variant.featured_media %}
      "image": {{ variant.featured_media | image_url: width: 1200 | prepend: 'https:' | json }},
      {%- endif %}
      {%- for option in product.options_with_values -%}
        {%- assign o = option.name | downcase -%}
        {%- if o contains 'taille' or o contains 'size' %}
      "size": {{ variant.options[forloop.index0] | json }},
        {%- elsif o contains 'couleur' or o contains 'color' %}
      "color": {{ variant.options[forloop.index0] | json }},
        {%- endif -%}
      {%- endfor %}
      "offers": {
        "@type": "Offer",
        "url": {{ seo_url | append: '?variant=' | append: variant.id | json }},
        "price": {{ variant.price | divided_by: 100.0 | json }},
        "priceCurrency": {{ cart.currency.iso_code | json }},
        "itemCondition": "https://schema.org/NewCondition",
        "availability": "https://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}"
      }
    }{% unless forloop.last %},{% endunless %}
    {%- endfor %}
  ]
}
</script>
{%- endif %}
